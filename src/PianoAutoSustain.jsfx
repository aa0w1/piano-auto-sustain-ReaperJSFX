// Piano Auto Sustain — JSFX 实现，分节标记：M1 参数管线 / M2 MIDI I/O / M3 状态机 / M4 踏板调度 / M5 诊断 / M6 UI（M5 归 T3、M6 归 T4/T5）
// 依据：sds.md v1.3（D1–D25）+ plan.md v0.5；当前进度 T5：T1–T4 完成之上补齐高级设置/诊断/说明书三页（M6 四页齐备）。

desc:Piano Auto Sustain (MIDI)
in_pin:none
out_pin:none
options:gfx_hz=60

// slider 命名以 - 前缀隐藏（通用界面不显示，仍可自动化/持久化，P4）；默认值写在头部（P1），@init 绝不写 slider（N1）。
// slider1 启用自动踏板(1) | slider2 低音识别上限(59=B3) | slider3 松弛后延音ms(2400) | slider4 和弦保护(1)
// slider5 忽略八度变化(1) | slider6 换踏间隙ms(20) | slider7 下踏人性化ms(12) | slider8 低音换踏限流窗ms(250)
// slider9 重复音限流窗ms(120) | slider10 重复音重踏(1) | slider11 通道作用域(0=全部/1-16=通道)
// slider12 CC目标(索引0/1/2 → 64/66/67，D9) | slider13~15 命令槽C01/C02/C03(上升沿消费) | slider16 C04_HoldOff(电平住slider，音频直写)
slider1:1<0,1,1>-P1_AutoEnable
slider2:59<0,127,1>-P2_BassCeil
slider3:2400<0,8000,1>-P3_TailMs
slider4:1<0,1,1>-P4_ChordProtect
slider5:1<0,1,1>-P5_IgnoreOctave
slider6:20<0,100,1>-P6_GapMs
slider7:12<0,50,1>-P7_HumanizeMs
slider8:250<0,500,1>-P8_BassWindowMs
slider9:120<0,500,1>-P9_RepeatWindowMs
slider10:1<0,1,1>-P10_RepeatRepedal
slider11:0<0,16,1>-P11_ChScope
slider12:0<0,2,1{64,66,67}>-P12_CCTarget
slider13:0<0,1,1>-C01_TapRep
slider14:0<0,1,1>-C02_Release
slider15:0<0,1,1>-C03_RestoreDefaults
slider16:0<0,1,1>-C04_HoldOff

@init
/* === M1 参数管线 === */

// ---- 常量区（T4 在此追加 UI 颜色/布局常量）----
CC_ON = 127;   // 自动侧踩下值
CC_OFF = 0;    // 自动侧抬起值

// ---- UI 主题/布局/字号常量（U1 象牙琴房重构：冻结 token 全表见 tests/T4坐标表.md「U1 象牙琴房演奏页」节；
//      文本色 0xRRGGBB 走 ui_draw_text 系，图元色经 ui_set_rgb 换算 0..1）----
// 结构：乌木盖板区（上 172）+ 黄铜分隔线 2px + 毛毡红线 2px + 象牙面板区（176 至窗底）
UI_C_EBONY1 = 0x17130F;   // 乌木渐变顶
UI_C_EBONY2 = 0x221A11;   // 乌木渐变中停（58%）
UI_C_EBONY3 = 0x1A140D;   // 乌木渐变底
UI_C_BRASS  = 0xB08D57;   // 黄铜：分隔线/副题/嵌线端色/激活页签底（底色配 alpha 由调用方定）
UI_C_FELT   = 0xA03A34;   // 毛毡红线 / 踏板踩下态状态字
UI_C_IVORY1 = 0xF4ECDA;   // 象牙渐变顶
UI_C_IVORY2 = 0xEAD9BB;   // 象牙渐变底
UI_C_TITLE  = 0xF0E6CF;   // 标题衬线字 / 步进小钮·三按钮文字 / 开态旋钮
UI_C_TABTXT = 0xCBB98F;   // 页签未激活文字
UI_C_TABON  = 0xE8D9B0;   // 页签激活文字
UI_C_LEDON  = 0xC9A05A;   // LED 开 / 踏板释放态状态字
UI_C_LEDOFF = 0x4A3F2D;   // LED 关
UI_C_INK    = 0x33261A;   // 象牙区主文字（大数字 / 开关行文字）
UI_C_IVLBL  = 0x6D5B3E;   // 象牙区标签
UI_C_IVUNIT = 0x8A7452;   // 单位 / 状态行 / 象牙禁用文字
UI_C_IVCARD = 0xFFFCF2;   // 参数卡底（alpha 0.65 由调用方定）
UI_C_IVEDGE = 0xCDB98D;   // 参数卡 / 开关行描边
UI_C_STEPBG = 0x2B2016;   // 步进小钮底 / 开态轨道 / 开关关态旋钮 / 三按钮底
UI_C_BTNEDGE = 0x17130F;  // 三按钮描边（=乌木渐变顶）
UI_C_TGOFF  = 0xC8B48A;   // 开关关态轨道（象牙）
UI_C_KNOBDIS = 0xEFE9DA;  // 灰置旋钮（象牙禁用态，T5 toggle2 专用）
UI_C_STEM1 = 0x9C9CA0;  UI_C_STEM2 = 0xE4E4E8;  UI_C_STEM3 = 0x83838A;    // 立柱横渐变三停（45%）
UI_C_PLATE1 = 0xECEFF2; UI_C_PLATE2 = 0xB9BCC2; UI_C_PLATE3 = 0x77787F;   // 踏板面垂直渐变三停（45%）
UI_C_PLATEDG = 0x5C5D63;  // 踏板面描边
UI_C_INLAY2 = 0xD9B77C;   // 黄铜嵌线中停（两端=UI_C_BRASS）
// U2：T5 三页暗色主题八常量（卡片底/按钮底/开关关轨/描边/冰蓝强调/主文字/次文字/开关旋钮）已随三页象牙
// 换肤全部删除——三页复用 U1 象牙 token（卡 IVICARD/IVEDGE、字 INK/IVLBL/IVUNIT/TITLE、底 STEPBG/BTNEDGE），
// 无新增配色常量；grep 常量名应为零命中（本注释不含常量名，供自检1 复核）

UI_W0 = 380;  UI_H0 = 460;                     // 设计基准尺寸
UI_M = 10;                                     // 页边距（页签栏/三页内容仍用；象牙区页内边距 14 页内直书）
UI_GAP = 8;                                    // 通用间距（三按钮行 8；参数卡/开关行间距 10 页内直书）
UI_TAB_Y = 2;  UI_TAB_H = 20;  UI_TAB_G = 2;   // 页签栏（乌木区顶）
UI_CARD_H = 74;                                // 参数卡高（象牙卡）
UI_BTN_H = 26;                                 // 三按钮高
UI_TGL_H = 26;                                 // 高级页行卡高（T5 不动）
UI_TG_H = 28;                                  // 演奏页开关行高
UI_STP_W = 40;  UI_STP_H = 26;                 // 高级页步进钮（T5 不动）
UI_STP2_W = 22;  UI_STP2_H = 16;               // 演奏页卡内步进小钮
UI_PED_W = 120;  UI_PED_H = 118;               // 侧视琴架踏板 lyre（U1 重定义）
UI_FS_TITLE = 16;  UI_FS_SUB2 = 9.5;  UI_FS_TAB = 10.5;  UI_FS_TGL = 11.5;   // U1 新字号（衬线标题/黄铜字/页签/开关行）
UI_FS_PEDST = 10;  UI_FS_NUM2 = 25;  UI_FS_SYM2 = 11;                        // U1 踏板状态字/大数字/小钮符号
UI_FS_SUB = 9;  UI_FS_LBL = 11;  UI_FS_TXT = 12;   // T5 三页沿用字号
UI_FS_SM = 10;  UI_FS_NUM = 20;  UI_FS_SYM = 14;
UI_BC_STEP = 1;  UI_TAIL_STEP = 100;           // 步进量（页面调用与 ui_act_fire 同源）
// T5 高级页步进量（同源机制：实际步进在 ui_act_fire 生效，与 T4 坐标表决议7 一致）
UI_ADV_GAP_STEP = 5;  UI_ADV_HUM_STEP = 1;  UI_ADV_WIN_STEP = 25;   // 换踏间隙/人性化/两限流窗（ms）
UI_ADV_SCOPE_STEP = 1;  UI_ADV_CC_STEP = 1;                          // 通道作用域/CC 目标枚举索引
UI_SC_MIN = 0.75;                              // 缩放下限钳制（更小窗口允许裁切）

// 页级 Y 锚（I4 常量化：设计值，落地 = ui_oy + 值×ui_sc；U1 全表见 tests/T4坐标表.md「U1 象牙琴房演奏页」节）
UI_Y_TITLE = 24;   UI_Y_SUB = 41;              // 标题/副题（乌木区左列，衬线+黄铜）
UI_Y_LED = 27;     UI_Y_ON = 38;               // 总开关 LED 圆顶/ON·OFF 文字（右上，兼命中区 id4）
UI_Y_SPLIT = 172;  UI_Y_IVORY = 176;           // 黄铜分隔线顶（172..174）/象牙区顶（毛毡线 174..176）
UI_Y_HAIR = 188;                               // 象牙区上缘发丝线（象牙顶+12）
UI_Y_LYRE = 46;    UI_Y_PEDSTAT = 52;          // 踏板 lyre 顶/踏板状态字（乌木区）
UI_Y_CARD1 = 194;                              // 参数卡顶（双卡并排，无第二排）
UI_Y_TGLROW = 282; UI_Y_HINT = 318;            // 开关行/说明一行
UI_Y_BTN = 340;    UI_Y_STATUS = 442;          // 三按钮/状态行（底部对齐）

// T5 高级页 Y 锚：行卡顶 = UI_Y_ADV1 + 行号×UI_Y_ADV_DP（行号 0..6），说明行 = 本行卡顶 + UI_Y_ADV_D
UI_Y_ADV1 = 66;  UI_Y_ADV_DP = 46;  UI_Y_ADV_D = 28;
// T5 诊断页 Y 锚：三真值卡/三数据行/事件日志卡/type6 说明行（UI_DG_VX=值列左缘、UI_DG_LOG_N=日志显示条数）
UI_Y_DG_CARD = 66;  UI_DG_CARD_H = 68;
UI_Y_DG_R1 = 142;  UI_Y_DG_R2 = 162;  UI_Y_DG_R3 = 182;  UI_DG_VX = 96;
UI_Y_DG_LOG = 206;  UI_DG_LOG_H = 178;  UI_DG_LOG_N = 9;
UI_Y_DG_NOTE = 392;
// T5 说明书页 Y 锚：安装标题/正文行距/要点标题/要点首行/底部「详见」行
UI_Y_MAN1 = 66;  UI_Y_MAN_DP = 16;  UI_Y_MAN2 = 130;  UI_Y_MAN3 = 146;  UI_Y_MAN_REF = 432;

// UI 动作 id（= 命中槽 id，0..63；步进器占相邻双 id：−=id、+=id+1）
UI_A_TAB0 = 0;  UI_A_TAB1 = 1;  UI_A_TAB2 = 2;  UI_A_TAB3 = 3;
UI_A_EN = 4;
UI_A_BC_M = 5;  UI_A_BC_P = 6;
UI_A_TAIL_M = 7;  UI_A_TAIL_P = 8;
UI_A_CHORD = 9;  UI_A_OCT = 10;
UI_A_TAP = 11;  UI_A_REL = 12;  UI_A_RST = 13;
// T5 高级页动作 id（14..19 留空隔断；步进器占相邻双 id：−=id、+=id+1）
UI_A_GAP_M = 20;  UI_A_GAP_P = 21;     // 换踏间隙（cfg idx6）
UI_A_HUM_M = 22;  UI_A_HUM_P = 23;     // 下踏人性化（idx7）
UI_A_WB_M  = 24;  UI_A_WB_P  = 25;     // 低音换踏限流窗（idx8）
UI_A_WR_M  = 26;  UI_A_WR_P  = 27;     // 重复音限流窗（idx9）
UI_A_REP   = 28;                       // 重复音重踏开关（idx10；cfg_chord==0 灰置）
UI_A_SCOPE_M = 29; UI_A_SCOPE_P = 30;  // 通道作用域（idx11）
UI_A_CCT_M = 31;  UI_A_CCT_P = 32;     // CC 目标（idx12 枚举索引）

// UI 文案（# 串槽 @init 赋值；绘制输出经 gfx_printf 每帧重新格式化）
#str_title="Piano Auto Sustain";  #str_sub="PIANO AUTO PEDAL";   // 副题=黄铜字全大写（U1 视觉规格）
#str_t0="演奏";  #str_t1="高级设置";  #str_t2="诊断";  #str_t3="说明书";
#str_on="ON";  #str_off="OFF";                                   // 总开关 LED 旁文字（U1）
#str_pstat="SUSTAIN";  #str_psep=" · ";  #str_pd="踩下";  #str_prel="释放";   // 踏板状态字三段（U1）
#str_bc="低音识别上限";  #str_tl="松弛后的延音";
#str_ch="和弦保护";  #str_oc="忽略八度变化";
#str_hint="和弦保护：低音区新音级触发换踏；忽略八度：低音同音级跨八度不换踏";
#str_b1="换踏一次";  #str_b2="释放踏板";  #str_b3="恢复默认";
#str_note="音符 ";  #str_minus="−";  #str_plus="＋";             // 步进符号改 U+2212/全角＋（mockup 字形）
#str_ver="PIANO AUTO SUSTAIN · 1.0";                             // 状态行右侧品牌串（U1）
#ui_chbuf="    ";                                                // 逐字符绘制单字符缓冲（容量种子，U1）
#ui_lsstr="";                                                    // 逐字距绘制源串槽（调用方赋值，U1）

// T5 高级页文案（7 行标签 + 值后缀/枚举显示 + 每行一行小字说明；ad5l=灰置锁定提示）
#str_gap="换踏间隙";  #str_hum="下踏人性化";  #str_wb="低音换踏限流窗";  #str_wr="重复音限流窗";
#str_rep="重复音重踏";  #str_scope="通道作用域";  #str_cct="CC 目标";
#str_ms="ms";  #str_all="全部";  #str_chn="通道 ";  #str_ccp="CC ";
#str_ad1="换踏时抬-踩之间的间隔，越大切音越干净、顿挫越明显";
#str_ad2="踩下沿附加延迟与 ±2ms 抖动，手感更接近真人";
#str_ad3="两次低音换踏的最小间隔；嫌换踏密就调大";
#str_ad4="两次重复音重踏的最小间隔";
#str_ad5="同音重击触发一次换踏（需和弦保护=开）";
#str_ad5l="和弦保护关闭时无效";
#str_ad6="仅处理所选通道；多音色 item 建议设单通道";
#str_ad7="生成的延音 CC 控制器号";
// T5 诊断页文案（三真值/三数据行/日志头；事件 type 短文案见 ui_dg_fmt）
#str_dg_hw="硬件";  #str_dg_au="自动";  #str_dg_sy="合成";
#str_dg_held="按住音符数";  #str_dg_bass="低音和声";  #str_dg_sent="发送计数";
#str_dg_dash="—";  #str_dg_log="最近事件（新在上）";
#str_dg_t0="踩下";  #str_dg_t1="抬起";  #str_dg_t2="换踏";  #str_dg_t3="硬件";
#str_dg_t4a="复位 总开关";  #str_dg_t4b="复位 CC120/123";
#str_dg_t5="进入挂起";  #str_dg_t5r="解除挂起";  #str_dg_t6="重同步";
#str_dg_k1="低音";  #str_dg_k2="重复";  #str_dg_k3="按钮";
#str_dg_note="「重同步」为状态补发（亦计入发送计数），非踩/抬动作";
// T5 说明书页文案（极简版：安装 2 行 + 要点 6 行 + 底部指向 docs；路径串不以 \ 结尾，规避串槽收尾歧义）；
// U2：要点编号拆独立串槽（①~⑤ 黄铜点缀绘制；多字节安全——不做字节级拆分，U1 偏离记录 3 同源约定）
#str_man_h1="安装";
#str_man_i1="复制本文件到 %APPDATA%\REAPER\Effects 目录";
#str_man_i2="然后在 REAPER 中刷新 FX 列表即可插入。";
#str_man_h2="使用要点";
#str_man_p1n="① ";  #str_man_p1="高音（上限以上）只踩不换踏，是结构设计。";
#str_man_p2n="② ";  #str_man_p2="低音逐音限流换踏是特性；嫌密可调大低音限流窗、";
#str_man_p3="　　上移低音上限，或切简单模式。";
#str_man_p4n="③ ";  #str_man_p4="上限设在左手最高和声音之上、旋律最低音之下；";
#str_man_p4b="旋律下探中音区则下调；纯右手独奏可调至极低（等效关闭锚定）。";
#str_man_p5n="④ ";  #str_man_p5="右手独奏换和弦用「换踏一次」救场（可 MIDI learn 绑键）。";
#str_man_p6n="⑤ ";  #str_man_p6="回放已烘焙踏板的工程请先关闭总开关。";
#str_man_ref="详见 docs/使用说明.md";

// ---- 音名表（N-4：EEL2 无字符串数组 → 12 个 #string + 算术派生；C4=60 约定）----
// 派生公式：pc = note % 12；八度 = (note/12|0) - 1。
// 心算验证 note=59 → pc=59%12=11 → #nn11="B"；八度=(59/12|0)-1 = 4-1 = 3 → "B3" ✓
#nn0="C";  #nn1="C#"; #nn2="D";  #nn3="D#";
#nn4="E";  #nn5="F";  #nn6="F#"; #nn7="G";
#nn8="G#"; #nn9="A";  #nn10="A#"; #nn11="B";

/* ---- 基址登记表（sds §2.3 / D10；EEL2 无 name@addr 语法 → 落地基址常量）----
 * EEL2 的 [] 为「左侧值 + 括号内值」求和后的绝对寻址（官方文档），命名变量与该内存空间相互独立；
 * 故以 g_mem=0 作锚：g_mem[基址 + idx] 即 mem[登记地址 + idx]，下标整型一律 …|0（官方建议手动取整）。
 *   登记记法               基址常量           区间          内容
 *   st_note_cnt@0[128]    g_note_cnt = 0     0..127       按住计数 per pitch
 *   st_bass_pc@128[12]    g_bass_pc  = 128   128..139     低音区 pitch-class 按住计数
 *   st_ch_auto@140[16]    g_ch_auto  = 140   140..155     通道发过自动 CC 标志
 *   st_out_last@156[16]   g_out_last = 156   156..171     通道上次合成输出值（I-3 按通道去重）
 *   slot_prev@172[3]      g_slot_prev= 172   172..174     命令槽影子（D19 独立上升沿）
 *   diag 环形@176[256]    g_diag     = 176   176..431     M5 诊断环形日志 64 条 × 4 字段 [type,a,b,seq]（D20/T3）
 *   diag 快照@432[17]     g_diag_snap= 432   432..448     M5 固定快照：+0 hw/+1 auto/+2 合成参考/+3 held/+4..15 bass_pc/+16 实发计数
 *   cc_map@512[3]         g_cc_map   = 512   512..514     CC 目标映射 {64,66,67}（D9）
 *   ui_hit@2048[256]      g_ui_hit   = 2048  2048..2303   UI hit-test（4页×16控件×4字段，N-7）
 * 逻辑区间 0..127/128..139/140..155/156..171/172..174/176..431/432..448/512..514/2048..2303 无重叠
 * （diag 两区取空闲区 175..511 内的 176..448，T3 登记）；后续任务新增数组须先在此登记新基址（避开上列区间并更新本表）。
 */
g_mem = 0;        // 锚变量：仅取其值 0 作「左侧值」，使 [g_基址 + idx] 即绝对地址
g_note_cnt = 0;
g_bass_pc = 128;
g_ch_auto = 140;
g_out_last = 156;
g_slot_prev = 172;
g_diag = 176;        // M5 诊断环形日志基址（64 条 × 4 字段 = 256 槽，D20/T3）
g_diag_snap = 432;   // M5 固定快照基址（17 槽，布局见基址登记表）
g_cc_map = 512;
g_ui_hit = 2048;

// cc_map 常量表初始化（D9：{64,66,67}；常量数据非运行态，@init 幂等重写，不属于状态清零）
g_mem[g_cc_map + 0] = 64;
g_mem[g_cc_map + 1] = 66;
g_mem[g_cc_map + 2] = 67;

// cfg_* 变量清单（EEL2 未定义变量静默为 0，逐一登记在案）：
//   12 参数镜像 cfg_enabled cfg_bass_ceil cfg_tail_ms cfg_chord cfg_ign_oct cfg_gap_ms
//              cfg_hum_ms cfg_win_bass_ms cfg_win_rep_ms cfg_repeat_repedal cfg_ch_scope cfg_cc
//   5 派生采样数 cfg_tail_smp cfg_gap_smp cfg_hum_smp cfg_win_bass_smp cfg_win_rep_smp

// slider1..12 → 12 个 cfg_ 变量 + 5 个派生采样数（ms→采样：ms*srate*0.001）
function cfg_sync_from_sliders() (
  cfg_enabled = slider1;
  cfg_bass_ceil = slider2;
  cfg_tail_ms = slider3;
  cfg_chord = slider4;
  cfg_ign_oct = slider5;
  cfg_gap_ms = slider6;
  cfg_hum_ms = slider7;
  cfg_win_bass_ms = slider8;
  cfg_win_rep_ms = slider9;
  cfg_repeat_repedal = slider10;
  cfg_ch_scope = slider11;
  cfg_cc = g_mem[g_cc_map + (slider12|0)];   // D9：索引 0/1/2 → CC 64/66/67
  cfg_tail_smp     = cfg_tail_ms     * srate * 0.001;
  cfg_gap_smp      = cfg_gap_ms      * srate * 0.001;
  cfg_hum_smp      = cfg_hum_ms      * srate * 0.001;
  cfg_win_bass_smp = cfg_win_bass_ms * srate * 0.001;
  cfg_win_rep_smp  = cfg_win_rep_ms  * srate * 0.001;
);

// 程序化写参（EEL2 无 slider[idx] 间接寻址 → if 链直写；D13：写值 + slider_automate + 同步）。
// 契约（T2 挂账落实）：idx = slider 编号 1..12；slider12 传枚举索引 0/1/2（非 CC 号）；越界静默忽略。
// 注意：函数体含 slider 写入，但仅在 T2 命令槽 / T4 UI 调用时执行；@init 执行路径不写 slider。
function cfg_set_param(idx, val) (
  idx == 1  ? (slider1 = val; slider_automate(slider1))
  : idx == 2  ? (slider2 = val; slider_automate(slider2))
  : idx == 3  ? (slider3 = val; slider_automate(slider3))
  : idx == 4  ? (slider4 = val; slider_automate(slider4))
  : idx == 5  ? (slider5 = val; slider_automate(slider5))
  : idx == 6  ? (slider6 = val; slider_automate(slider6))
  : idx == 7  ? (slider7 = val; slider_automate(slider7))
  : idx == 8  ? (slider8 = val; slider_automate(slider8))
  : idx == 9  ? (slider9 = val; slider_automate(slider9))
  : idx == 10 ? (slider10 = val; slider_automate(slider10))
  : idx == 11 ? (slider11 = val; slider_automate(slider11))
  : idx == 12 ? (slider12 = val; slider_automate(slider12))
  : 0;
  cfg_sync_from_sliders();
);

// 恢复默认（C03/D13）：12 参数逐一写回首部默认值 + slider_automate + 同步；undo 点由 @gfx 调用方以 sliderchange(-1) 产生
function cfg_restore_defaults() (
  slider1 = 1;    slider_automate(slider1);
  slider2 = 59;   slider_automate(slider2);
  slider3 = 2400; slider_automate(slider3);
  slider4 = 1;    slider_automate(slider4);
  slider5 = 1;    slider_automate(slider5);
  slider6 = 20;   slider_automate(slider6);
  slider7 = 12;   slider_automate(slider7);
  slider8 = 250;  slider_automate(slider8);
  slider9 = 120;  slider_automate(slider9);
  slider10 = 1;   slider_automate(slider10);
  slider11 = 0;   slider_automate(slider11);
  slider12 = 0;   slider_automate(slider12);
  cfg_sync_from_sliders();
);

/* ---- T2 运行态标量登记（EEL2 未定义变量静默为 0，逐一登记；全部非持久化，D7 v1.3）----
 *   门控/时基：st_booted（@block 首块门控）  st_resync_pending（@init 置 1）  st_abs_smp  st_prev_enabled
 *   状态机：st_held_total  st_last_note  st_tail_end  st_evt_seq  st_hw_cc  st_auto_cc
 *   单槽调度器：ped_active  ped_down_at  ped_ch  ped_kind
 *   限流窗止（绝对时刻）：win_bass_end  win_rep_end
 * 数组寻址：一律 g_mem[基址常量 + 下标]（T1 基址登记表），严禁 st_/ped_ 前缀名直接下标；
 *   变量下标按 P11 以 (x|0) 取整，时间戳与块内偏移按 D10 保持浮点、一律不加 |0；
 *   局部暂存一律函数 local() 声明（跨函数互不可见；跨函数共享数据只走 g_mem 数组，N10）。
 */

/* === M5 诊断（T3 / D20 / SDS §2.5）====
 * 物理位置约束：diag_log 的最早调用方是叶子函数 io_send_cc_raw，EEL2 先声明后调用 → 本节先于全部调用方定义。
 * 运行态标量登记（EEL2 未定义变量静默为 0，逐一登记；非持久化，D7 v1.3）：
 *   diag_head（环形写头 0..63）  diag_seq（条目序号，单调递增不复位）  cc_sent_total（CC/合成流实发累计计数）
 * 环形条目 4 字段 [type, a, b, seq]（g_diag，64 条覆盖写；seq 先自增再入槽 → 首条=1、未写槽=0 可辨）。
 * a/b 语义随 type（D20）：
 *   0/1 踩/抬沿 a=ch b=意图值；2 换踏 a=ch b=note+kind*1000（N-5：kind 读取者；实际 kind∈1..3）；
 *   3 硬件 CC a=ch b=val；4 复位 a=reason b=t_abs（时间戳浮点原样、不取整）；
 *   5 挂起翻转 a=ch（命令槽路径=-1 哨兵）b=翻转后新值；6 合成重同步 a=目标/fallback 通道 b=合成值。
 * 快照固定槽布局（g_diag_snap 17 槽，同基址登记表）：
 *   +0 st_hw_cc +1 st_auto_cc +2 out_last@156 之索引0（合成参考通道=索引0，D4/D17，设计自定）+3 st_held_total
 *   +4..+15 低音 pc（st_bass_pc@128 十二项）+16 cc_sent_total
 */

// 数值环形日志（D20）：纯数值、覆盖写、head 环形推进；仅下标取整，时间戳/序号按 D10 保持浮点
function diag_log(type, a, b) (
  diag_seq = diag_seq + 1;
  g_mem[g_diag + (diag_head|0)*4 + 0] = type;         // 槽0 type（条目步长 ×4：k 号条目占槽 4k..4k+3，B-1 修复）
  g_mem[g_diag + (diag_head|0)*4 + 1] = a;            // 槽1 a
  g_mem[g_diag + (diag_head|0)*4 + 2] = b;            // 槽2 b
  g_mem[g_diag + (diag_head|0)*4 + 3] = diag_seq;     // 槽3 seq（读者据此判序/回绕）
  diag_head = (diag_head + 1) % 64;                   // 环形推进（覆盖最旧条目）
);

// 每块末固定快照（SDS §2.5）：三真值 + held + bass_pc[12] + 实发计数 → g_diag_snap 固定槽
function diag_snapshot() local(diag_i) (
  g_mem[g_diag_snap + 0] = st_hw_cc;                  // 真值1 硬件 CC
  g_mem[g_diag_snap + 1] = st_auto_cc;                // 真值2 自动意图态
  g_mem[g_diag_snap + 2] = g_mem[g_out_last + 0];     // 真值3 合成参考值 = out_last[0]（D4/D17 fallback 参考通道）
  g_mem[g_diag_snap + 3] = st_held_total;             // 按住总数
  diag_i = 0;
  while (diag_i < 12) (
    g_mem[g_diag_snap + 4 + (diag_i|0)] = g_mem[g_bass_pc + (diag_i|0)];   // 低音 pc 12 项
    diag_i = diag_i + 1;
  );
  g_mem[g_diag_snap + 16] = cc_sent_total;            // 实发累计计数
);

/* === M2 MIDI I/O · 出口原语（叶子先行）===
 * io_send_cc_raw 与 io_send_synth 仅依赖 midisend，是全插件的叶子函数；
 * 因 ped_/st_/cmd_ 各函数都调用它们，EEL2 先声明后调用 → 物理位置必须最前
 * （SDS §2.4 的依赖序压倒任务单「ped_→st_→cmd_→io_」的模块列举序，T2 汇报记录此偏离）。
 */

// 自动沿唯一出口（D24）：出口内合并硬件 out = max(val, st_hw_cc)，按通道去重后 midisend（合成单流，plan §3.1 B1）；
// 记 st_auto_cc = 意图值、并把 st_ch_auto 该通道标志置 1；diag 按意图值记（D20 type0/1，已接线）。
function io_send_cc_raw(off, ch, val) local(io_out) (
  io_out = max(val, st_hw_cc);                        // D24 出口合成：硬件踩住时自动抬沿不切延音
  io_out != g_mem[g_out_last + (ch|0)] ? (
    midisend(off, 0xB0 | ch, cfg_cc, io_out);         // 去重守卫（I-3）：与该通道上次输出相同则不重发（ch 由位运算得来，恒整）
    cc_sent_total = cc_sent_total + 1;                // M5 实发计数：仅实际 midisend 递增（T3）
  ) : 0;
  g_mem[g_out_last + (ch|0)] = io_out;                // 恒写（等值时为无害重写）
  st_auto_cc = val;                                   // D24：意图态 0/127
  g_mem[g_ch_auto + (ch|0)] = 1;                      // D4：登记「该通道发过自动 CC」
  val == CC_ON ? diag_log(0, ch, val)                 // D20 type0 踩沿（按意图值，D24；去重吞发不影响意图记录）
  : val == CC_OFF ? diag_log(1, ch, val)              // D20 type1 抬沿（按意图值）
  : 0;                                                // 出口约定仅 0/127 两值
);

// 合成重同步出口（D25）：独立实现、不经 io_send_cc_raw；
// 目标 = st_ch_auto 全部 ∪ 事件通道（事件通道缺失时 fallback 索引 0，D4/D17）；
// 逐通道 eff = max(st_hw_cc, st_auto_cc) 发合成流并按通道写 st_out_last；不触 st_auto_cc / st_ch_auto。
function io_send_synth(off, ev_ch) local(io_eff, io_tgt, io_i) (
  io_eff = max(st_hw_cc, st_auto_cc);
  io_tgt = ev_ch < 0 ? 0 : ev_ch;                     // D17 fallback 索引 0
  io_eff != g_mem[g_out_last + (io_tgt|0)] ? (
    midisend(off, 0xB0 | io_tgt, cfg_cc, io_eff);     // io_tgt 恒整（位运算结果或 fallback 0）
    cc_sent_total = cc_sent_total + 1;                // M5 实发计数：仅实际 midisend 递增（T3）
  ) : 0;
  g_mem[g_out_last + (io_tgt|0)] = io_eff;
  io_i = 0;
  while (io_i < 16) (                                 // 目标集其余成员 = st_ch_auto 全部（D8 先置 -1 破守卫以强制重发）
    g_mem[g_ch_auto + (io_i|0)] != 0 && io_i != io_tgt ? (
      io_eff != g_mem[g_out_last + (io_i|0)] ? (
        midisend(off, 0xB0 | io_i, cfg_cc, io_eff);   // io_i 循环计数恒整
        cc_sent_total = cc_sent_total + 1;            // M5 实发计数：仅实际 midisend 递增（T3）
      ) : 0;
      g_mem[g_out_last + (io_i|0)] = io_eff;
    ) : 0;
    io_i = io_i + 1;
  );
  diag_log(6, io_tgt, io_eff);                        // D20 type6 合成重同步（a=事件目标/fallback 通道，b=合成值）
);

/* === M4 踏板调度（单槽调度器，plan §3.2.16 / 审核 P6c；物理顺序叶子在前）=== */

// 下踏人性化抖动（plan §3.2.10 / P8）：LFSR 种子 = 音符 + 事件序号（与音频块划分无关，跨设备/缓冲配置结果一致），
// 每次生成事件 st_evt_seq 自增（X11）；返回 ±2ms 对应的采样数（时间戳语境，浮点，不加 |0）。
function ped_jitter(note) local(ped_lfsr, ped_fb, ped_k) (
  ped_lfsr = (note + st_evt_seq) & 0xFFFF;            // 位运算自动取整 → 16 位种子
  st_evt_seq = st_evt_seq + 1;                        // 每次生成事件序号自增（X11）
  ped_lfsr == 0 ? ( ped_lfsr = 0xACE1; ) : 0;         // LFSR 防全零锁死（经典 16 位种子）
  ped_k = 0;
  while (ped_k < 8) (                                 // 推进 8 拍去相关（确定性，步数固定）
    ped_fb = (ped_lfsr & 1) ^ ((ped_lfsr >> 2) & 1) ^ ((ped_lfsr >> 3) & 1) ^ ((ped_lfsr >> 5) & 1);
    ped_lfsr = (ped_lfsr >> 1) | (ped_fb << 15);      // 16 位 Fibonacci LFSR（taps 16/14/13/11）
    ped_k = ped_k + 1;
  );
  (((ped_lfsr & 0xFFFF) - 32768) / 32768) * 2 * srate * 0.001;   // 映射 -2ms ~ +2ms 采样数
);

// 普通踩下入槽（plan §3.2.16③）：槽 = {active, down_at = t_abs + max(hum+jitter, 0), ch, kind 0}；
// 前置：槽 IDLE（调用方独占链①保证）；在途吸收由独占链①承担，此处永不覆盖旧踩沿。
function ped_press(t_abs, ch, note) (
  ped_active = 1;
  ped_down_at = t_abs + max(cfg_hum_smp + ped_jitter(note), 0);   // D12 钳制
  ped_ch = ch;
  ped_kind = 0;                                       // kind0=普通踩下（D18）；kind 的读取者 = diag_log type2 之 b 千位编码（N-5）；本路径沿事件由 type0 记录
);

// 换踏（plan §3.2.8；前置：槽 IDLE 且 st_auto_cc==127，D2/D15 由调用方保证——槽在途时①吸收，永不覆盖旧踩沿）：
// ① 立即抬沿：对 st_ch_auto（空→索引 0）逐通道 io_send_cc_raw（抬沿不受人性化，plan §3.2.8）；
// ② 踩沿入槽（D12：down_at = t_abs + gap + max(hum+jitter, 0)，保证沿序 ≥ 抬沿 + gap，P6b）；
// ③ kind 1 开低音限流窗、kind 2 开重复音限流窗、kind 3 按钮不开窗（D18 / plan §3.2.11）。
function ped_rep(t_abs, ch, note, kind) local(ped_bs, ped_off, ped_any, ped_i) (
  ped_bs = st_abs_smp - samplesblock;                 // 当前块首（§2.1）
  ped_off = t_abs - ped_bs;                           // 抬沿块内偏移（t_abs 恒在本块内）
  ped_any = 0;
  ped_i = 0;
  while (ped_i < 16) (
    g_mem[g_ch_auto + (ped_i|0)] != 0 ? (
      io_send_cc_raw(ped_off, ped_i, CC_OFF);         // 抬沿逐通道（D4）
      ped_any = 1;
    ) : 0;
    ped_i = ped_i + 1;
  );
  ped_any == 0 ? ( io_send_cc_raw(ped_off, 0, CC_OFF); ) : 0;   // D4：目标空 → fallback 索引 0
  ped_active = 1;                                     // 踩沿入槽
  ped_down_at = t_abs + cfg_gap_smp + max(cfg_hum_smp + ped_jitter(note), 0);   // D12
  ped_ch = ch;
  ped_kind = kind;
  kind == 1 ? ( win_bass_end = t_abs + cfg_win_bass_smp; )
  : kind == 2 ? ( win_rep_end = t_abs + cfg_win_rep_smp; )
  : 0;                                                // kind 3：不开窗
  diag_log(2, ch, note + kind*1000);                  // D20 type2 换踏（含 kind3 按钮路径，X9）；b=note+kind*1000（kind∈1..3，note<1000 无歧义，N-5）
);

// 单槽出队仲裁（D16 / plan §3.2.16⑦）：A = 尾音 st_tail_end、B = 待踩沿 ped_down_at，按绝对时刻比较；
// 过期 clamp 到 block_start ~ block_start+n（块首）；到期时刻 ≥ 块末（上界含等号，I-5）顺延下块；
// 平局尾音先：尾音先发 → 槽取消 → 在途踩沿一并取消，踏板保持抬起（plan §3.2.16⑦）。
function ped_tick(block_start, n) local(ped_end, ped_a_due, ped_b_due, ped_a_off, ped_b_off, ped_any, ped_i) (
  ped_end = block_start + n;
  ped_a_due = st_tail_end >= 0 && st_tail_end < ped_end;      // 含过期（< 块首亦视为到期，下方 clamp）
  ped_b_due = ped_active != 0 && ped_down_at < ped_end;       // ≥ 块末顺延（上界含等号）
  ped_a_due != 0 && (ped_b_due == 0 || ped_down_at >= st_tail_end) ? (
    // 尾音先（含平局）
    ped_a_off = st_tail_end - block_start;
    ped_a_off < 0 ? ( ped_a_off = 0; ) : 0;           // 过期 clamp
    ped_active = 0;                                   // 槽取消（在途踩沿一并取消）
    ped_any = 0;
    ped_i = 0;
    while (ped_i < 16) (
      g_mem[g_ch_auto + (ped_i|0)] != 0 ? (
        io_send_cc_raw(ped_a_off, ped_i, CC_OFF);     // 释放沿逐通道（无人性化）
        ped_any = 1;
      ) : 0;
      ped_i = ped_i + 1;
    );
    ped_any == 0 ? ( io_send_cc_raw(ped_a_off, 0, CC_OFF); ) : 0;   // 空 → 索引 0
    st_tail_end = -1;
  ) : ped_b_due != 0 ? (
    // 踩沿先：落地 CC_ON，槽回 IDLE（尾音若同块稍后到期 → 下块 clamp 补发，≤1 块偏差）
    ped_b_off = ped_down_at - block_start;
    ped_b_off < 0 ? ( ped_b_off = 0; ) : 0;           // 过期 clamp
    io_send_cc_raw(ped_b_off, ped_ch, CC_ON);
    ped_active = 0;                                   // 槽 IDLE
  ) : 0;
);

// 限流窗查询（D18）：kind 1 → 低音窗、2 → 重复音窗、3 → 无窗（返回 -1 表示不开窗）；返回窗止绝对时刻。
function win_lookup(kind) (
  kind == 1 ? win_bass_end : kind == 2 ? win_rep_end : -1;
);

/* === M3 状态机（按住表 / 低音 pc 集合 / 重复音 / 新音级 / 挂起 / 独占链 / 软复位；
     定义顺序满足先声明后调用：st_request_rep → st_on_note_on → st_on_note_off → st_reset）=== */

// 限流窗闸（SDS §2.4 / plan §3.2.16）：事件时刻在对应窗内 → 吸收（落选者不开窗，N5）；否则转 ped_rep。
function st_request_rep(t_abs, ch, note, kind) (
  t_abs < win_lookup(kind) ? (
    0                                                 // 窗内吸收
  ) : (
    ped_rep(t_abs, ch, note, kind);
  );
);

// 音符触发（D22 三参）：挂起解除 → 旧值判定 repeat / new_bass_pc → 计数更新 → 尾音取消 →
// 独占链（D2 一次仲裁、互斥；②③带 D15 st_auto_cc==127 闸；同块双命中按重复音优先，N-3）。
function st_on_note_on(t_abs, ch, note) local(st_pc, st_is_bass, st_repeat, st_newbass) (
  slider16 == 1 ? (                                   // 挂起解除（下一次音符触发解除，plan §3.2.12）
    slider16 = 0;                                     // 直写 slider16（D1 音频直写例外）
    diag_log(5, ch, 0);                               // D20 type5 挂起翻转（1→0 恒为实际翻转；b=翻转后新值）
  ) : 0;
  st_pc = note % 12;
  st_is_bass = note <= cfg_bass_ceil;                 // 低音区（≤ 上限）= 换踏触发者（plan §3.2.5）
  st_repeat = note == st_last_note;                   // 重复音（任意音区，plan §3.2.9）
  st_newbass = st_is_bass != 0 && (cfg_ign_oct != 0
    ? g_mem[g_bass_pc + (st_pc|0)] == 0
    : (g_mem[g_bass_pc + (st_pc|0)] == 0 || g_mem[g_note_cnt + (note|0)] == 0));   // plan §3.2.4
  st_last_note = note;                                // 计数更新（判定用旧值，故先判后更）
  g_mem[g_note_cnt + (note|0)] = g_mem[g_note_cnt + (note|0)] + 1;
  st_held_total = st_held_total + 1;
  st_is_bass != 0 ? ( g_mem[g_bass_pc + (st_pc|0)] = g_mem[g_bass_pc + (st_pc|0)] + 1; ) : 0;
  st_tail_end = -1;                                   // 期间新音取消尾音计时（plan §3.2.6）
  ped_active != 0 ? 0                                 // ① 槽在途（含 gap/待踩沿）：全部吸收（plan §3.2.16①，N4/N8）
  : (cfg_chord != 0 && cfg_repeat_repedal != 0 && st_repeat != 0 && st_auto_cc == 127) ? (
    st_request_rep(t_abs, ch, note, 2);               // ② 重复音重踏（同命中优先，N-3；D15 闸）
  ) : (cfg_chord != 0 && st_newbass != 0 && st_auto_cc == 127) ? (
    st_request_rep(t_abs, ch, note, 1);               // ③ 低音新音级换踏（D15 闸；上限以上只踩不换，plan §3.2.2）
  ) : st_auto_cc == 0 ? (
    ped_press(t_abs, ch, note);                       // ④ 普通踩下（plan §3.2.1；自动侧已下则无动作）
  ) : 0;
);

// 音符释放（D22 三参 / plan §3.2.6）：note_cnt > 0 才递减（bass_pc 递减下限 0，X11）；
// 全部松开且未挂起 → 尾音计时（挂起期间尾音计时挂起，plan §3.2.12）；释放沿不受人性化。
function st_on_note_off(t_abs, ch, note) local(st_pc) (
  g_mem[g_note_cnt + (note|0)] > 0 ? (
    g_mem[g_note_cnt + (note|0)] = g_mem[g_note_cnt + (note|0)] - 1;
    st_held_total = st_held_total - 1;
    st_pc = note % 12;
    note <= cfg_bass_ceil ? (
      g_mem[g_bass_pc + (st_pc|0)] = max(g_mem[g_bass_pc + (st_pc|0)] - 1, 0);   // X11 下限 0
    ) : 0;
  ) : 0;
  st_held_total == 0 && slider16 == 0 ? (
    st_tail_end = t_abs + cfg_tail_smp;               // 释放沿即时刻、无人性化（plan §3.2.6）
  ) : 0;
);

// 软复位（D21 v1.3.1 / plan §3.2.14 总开关、§3.2.15 CC120/123）：reason 1 = 关沿、2 = CC120/123。
// 清槽 / 按住表 / 低音 pc / 两窗 / last_note / tail_end / 直写 slider16 = 0（挂起解除）；
// st_auto_cc==127 → 对 st_ch_auto（空→索引 0）逐通道立即发 io_send_cc_raw 之 off=0、val=CC_OFF
// （D24 出口合并保证硬件踩住时输出保持硬件值）；reason==2 → 尾音自愈兜底（去重守卫抑制重复发送）。
function st_reset(reason, t_abs) local(st_i, st_any) (
  ped_active = 0;                                     // 槽回 IDLE（在途待踩沿取消，plan §3.2.16⑤/N9）
  st_i = 0;
  while (st_i < 128) ( g_mem[g_note_cnt + (st_i|0)] = 0; st_i = st_i + 1; );   // 按住表清空
  st_held_total = 0;
  st_i = 0;
  while (st_i < 12) ( g_mem[g_bass_pc + (st_i|0)] = 0; st_i = st_i + 1; );     // 低音和声集合清空
  win_bass_end = -1;                                  // 两窗清（plan §3.2.16⑤）
  win_rep_end = -1;
  st_last_note = -1;
  st_tail_end = -1;
  slider16 = 0;                                       // 挂起解除（直写 slider16，D21）
  st_auto_cc == 127 ? (                               // 先判后放（io_send_cc_raw 会改写 st_auto_cc）
    st_any = 0;
    st_i = 0;
    while (st_i < 16) (
      g_mem[g_ch_auto + (st_i|0)] != 0 ? (
        io_send_cc_raw(0, st_i, CC_OFF);              // 立即释放（plan §3.2.15；偏移 0 = 块首）
        st_any = 1;
      ) : 0;
      st_i = st_i + 1;
    );
    st_any == 0 ? ( io_send_cc_raw(0, 0, CC_OFF); ) : 0;   // 空 → 索引 0（D4/D17）
  ) : 0;
  reason == 2 ? ( st_tail_end = t_abs + cfg_tail_smp; ) : 0;   // D21 自愈兜底（CC123 清表后尾音计时启动）
  diag_log(4, reason, t_abs);                         // D20 type4 复位（a=reason 1关沿/2 CC120·123；b=事件绝对时刻，浮点原样不取整）
);

/* === M2 MIDI I/O · 命令槽与 @block 主循环（cmd_* / io_dispatch / io_process_block）=== */

// C01 换踏一次（plan §3.2.11）：任何情况解除挂起；在途（gap/待踩沿）吸收、不排队（N-8）；
// 自动侧在下（st_auto_cc==127）→ 按钮换踏（kind 3：不受限流窗、不重开窗，D18/D20 X9）；否则仅踩下；
// 完成后无按住音符 → 尾音计时启动（plan §3.2.16⑥）。无事件调度点 t_abs = block_start（D17）。
function cmd_tap() local(cmd_bs, cmd_ch, cmd_i) (
  cmd_bs = st_abs_smp - samplesblock;                 // 当前块首（§2.1）
  slider16 == 1 ? (
    slider16 = 0;                                     // 解除挂起（任何情况，plan §3.2.11；直写 slider16）
    diag_log(5, -1, 0);                               // D20 type5 挂起翻转（1→0 恒为实际翻转；命令槽无关联通道，a=-1 哨兵）
  ) : 0;
  ped_active != 0 ? 0                                 // 在途被吸收、不排队（N-8）
  : (
    cmd_ch = -1;
    cmd_i = 0;
    while (cmd_i < 16) (                              // ch_first = st_ch_auto 升序首个非零，否则 0（D17）
      cmd_ch < 0 && g_mem[g_ch_auto + (cmd_i|0)] != 0 ? ( cmd_ch = cmd_i; ) : 0;
      cmd_i = cmd_i + 1;
    );
    cmd_ch < 0 ? ( cmd_ch = 0; ) : 0;
    st_auto_cc == 127 ? (
      ped_rep(cmd_bs, cmd_ch, 0, 3);                  // 按钮换踏（kind 3 不开窗，D18）
    ) : (
      ped_press(cmd_bs, cmd_ch, 0);                   // 踏板在上：仅踩下（plan §3.2.11）
    );
    st_held_total == 0 ? ( st_tail_end = cmd_bs + cfg_tail_smp; ) : 0;   // plan §3.2.16⑥
  );
);

// C02 释放踏板（plan §3.2.12）：槽取消；自动侧在下 → 对 st_ch_auto（空→索引 0）立即释放（D24 合并保护硬件）；
// 尾音取消；进入释放挂起（直写 slider16=1；挂起期间自动踩下/换踏/尾音计时全部挂起）。
function cmd_release() local(cmd_i, cmd_any) (
  ped_active = 0;                                     // 槽取消（gap 中待踩沿取消，plan §3.2.12）
  st_auto_cc == 127 ? (                               // 先判后放（io_send_cc_raw 会改写 st_auto_cc）
    cmd_any = 0;
    cmd_i = 0;
    while (cmd_i < 16) (
      g_mem[g_ch_auto + (cmd_i|0)] != 0 ? (
        io_send_cc_raw(0, cmd_i, CC_OFF);             // 自动侧立即释放（偏移 0 = 块首）
        cmd_any = 1;
      ) : 0;
      cmd_i = cmd_i + 1;
    );
    cmd_any == 0 ? ( io_send_cc_raw(0, 0, CC_OFF); ) : 0;   // 空 → 索引 0（D4/D17）
  ) : 0;
  st_tail_end = -1;
  slider16 == 0 ? diag_log(5, -1, 1) : 0;             // D20 type5 仅实际翻转 0→1 时记录（a=-1 哨兵：命令槽无关联通道）
  slider16 = 1;                                       // 进入释放挂起（C04_HoldOff 电平住 slider，直写）
);

// C03 恢复默认（D13 / plan §3.2.13）：仅复位参数，不动状态机/挂起标志/调度器；undo 点由 @gfx 调用方 sliderchange(-1) 产生。
function cmd_restore() (
  cfg_restore_defaults();
);

// MIDI 分类（SDS §2.4 / plan §3.1）：作用域外全部原样直通（§3.1 直通原则；通道作用域同时限定状态机输入，
// plan §3.1「多音色 item 应设通道作用域」）；0x9X vel0 归一为 Note Off（plan §3.1）；
// 0xBX 目标 CC → 拦截、只出合成流（plan §3.1 B1）；CC120/123 → 软复位 + 消息直通（plan §3.2.15/N3）；其余直通。
function io_dispatch(off, msg1, msg2, msg3) local(io_ch, io_st, io_t_abs, io_scope) (
  io_ch = msg1 & 0x0F;
  io_st = msg1 & 0xF0;
  io_t_abs = (st_abs_smp - samplesblock) + off;       // §2.1：事件绝对时刻
  io_scope = cfg_ch_scope == 0 || io_ch == cfg_ch_scope - 1;   // scope==0 全部 / 1-16 单通道
  io_scope == 0 ? (
    midisend(off, msg1, msg2, msg3);                  // 作用域外：原样直通
  ) : io_st == 0x90 ? (
    msg3 > 0 ? (
      st_on_note_on(io_t_abs, io_ch, msg2);           // D22 三参
    ) : (
      st_on_note_off(io_t_abs, io_ch, msg2);          // vel0 归一为 Note Off（plan §3.1）
    );
    midisend(off, msg1, msg2, msg3);                  // 直通
  ) : io_st == 0x80 ? (
    st_on_note_off(io_t_abs, io_ch, msg2);
    midisend(off, msg1, msg2, msg3);                  // 直通
  ) : io_st == 0xB0 ? (
    msg2 == cfg_cc ? (
      st_hw_cc = msg3;                                // 硬件真值（plan §3.2.7）
      diag_log(3, io_ch, msg3);                       // D20 type3 硬件 CC（启用态拦截分支）
      io_send_synth(off, io_ch);                      // 拦截合成单流、不直通（plan §3.1 B1）
    ) : (msg2 == 120 || msg2 == 123) ? (
      st_reset(2, io_t_abs);                          // 防卡死：与总开关软复位同待遇（plan §3.2.15/N3）
      midisend(off, msg1, msg2, msg3);                // 消息本身仍直通
    ) : (
      midisend(off, msg1, msg2, msg3);                // 非目标 CC：原样直通
    );
  ) : (
    midisend(off, msg1, msg2, msg3);                  // 其他消息直通（SysEx 已由 midirecv 原生直通，N-6）
  );
);

// @block 全序列（SDS §2.4）：哨兵引导 → 时基 → 开关沿+重同步 → D14 关态门控 → 命令槽 → midirecv → ped_tick → 收尾+diag 快照。
function io_process_block() local(bs, i, off, m1, m2, m3) (
  // ---- 步0 哨兵引导（D7 v1.3：st_booted 运行态门控，对 @init / @serialize 任何次序稳健）----
  st_booted == 0 ? (
    st_last_note = -1;
    st_tail_end = -1;
    st_evt_seq = 0;
    i = 0;
    while (i < 16) ( g_mem[g_out_last + (i|0)] = -1; i = i + 1; );   // out_last[16] = -1（去重守卫初值）
    st_hw_cc = 0;
    st_auto_cc = 0;
    ped_active = 0;
    win_bass_end = -1;                                // 两窗
    win_rep_end = -1;
    i = 0;
    while (i < 3) ( g_mem[g_slot_prev + (i|0)] = 0; i = i + 1; );    // 命令槽影子清零（D19）
    i = 0;
    while (i < 16) ( g_mem[g_ch_auto + (i|0)] = 0; i = i + 1; );     // ch_auto 清零
    slider16 = 0;                                     // D7：重载首块直写清 0（挂起标志复位）
    st_booted = 1;
  ) : 0;

  // ---- 步1 时基（§2.1：st_abs_smp 每块累加，block_start = 减回 samplesblock）----
  st_abs_smp = st_abs_smp + samplesblock;
  bs = st_abs_smp - samplesblock;

  // ---- 步2 开关沿 + 重同步（D6/D8，X1 修复）----
  cfg_enabled == 0 && st_prev_enabled != 0 ? (
    st_reset(1, bs);                                  // 下降沿：软复位（D21 reason 1，无尾音自愈）
  ) : 0;
  cfg_enabled != 0 && st_prev_enabled == 0 ? (
    st_resync_pending = 1;                            // 上升沿：置重同步
  ) : 0;
  st_resync_pending != 0 && cfg_enabled != 0 ? (
    i = 0;
    while (i < 16) ( g_mem[g_out_last + (i|0)] = -1; i = i + 1; );   // D8：全部置 -1 破去重守卫
    io_send_synth(0, 0);                              // D17：无事件调度点 off=0；补发合成值（仅启用时）
    st_resync_pending = 0;
  ) : 0;

  // ---- 步3 D14 关态门控 ----
  cfg_enabled == 0 ? (
    // 直通循环：目标 CC 仅跟踪 st_hw_cc（不拦截不合成，X2/I-2 修复幻象延音），其余完全直通（plan §3.2.14）
    while (midirecv(off, m1, m2, m3)) (
      (m1 & 0xF0) == 0xB0 && m2 == cfg_cc && (cfg_ch_scope == 0 || (m1 & 0x0F) == cfg_ch_scope - 1) ? (
        st_hw_cc = m3;
        diag_log(3, m1 & 0x0F, m3);                   // D20 type3 硬件 CC（关态跟踪分支，D14）
      ) : 0;
      midisend(off, m1, m2, m3);                      // 原样直通（含目标 CC）
    );
    diag_snapshot();                                  // 步3 收尾快照（关态亦记，§2.4）
    st_prev_enabled = 0;                              // X4：关态收尾同步
  ) : (
    // ---- 步4 命令槽消费（D19 独立上升沿；t_abs = block_start，D17；消费后清零，plan P7）----
    g_mem[g_slot_prev + 0] == 0 && slider13 == 1 ? ( cmd_tap(); slider13 = 0; ) : 0;
    g_mem[g_slot_prev + 1] == 0 && slider14 == 1 ? ( cmd_release(); slider14 = 0; ) : 0;
    g_mem[g_slot_prev + 2] == 0 && slider15 == 1 ? ( cmd_restore(); slider15 = 0; ) : 0;
    g_mem[g_slot_prev + 0] = slider13;                // 影子每块无条件同步（D19）
    g_mem[g_slot_prev + 1] = slider14;
    g_mem[g_slot_prev + 2] = slider15;

    // ---- 步5 midirecv 循环 → io_dispatch（「取全发全」；SysEx 由 midirecv 原生直通，N-6）----
    while (midirecv(off, m1, m2, m3)) (
      io_dispatch(off, m1, m2, m3);
    );

    // ---- 步6 ped_tick（D16 仲裁：绝对时刻比较 / 过期 clamp / ≥块末顺延 / 平局尾音先）----
    ped_tick(bs, samplesblock);

    // ---- 步7 收尾（X4：每块末无条件同步开关沿影子）----
    st_prev_enabled = cfg_enabled;

    // ---- 步8 诊断快照 ----
    diag_snapshot();                                  // §2.5：三真值/held/bass_pc[12]/实发计数 → 固定槽
  );
);

/* === M5 诊断 ===（已实现于 @init 前部 M5 节：diag_log / diag_snapshot 须先于最早调用方 io_send_cc_raw 定义，EEL2 先声明后调用） */

/* === M6 UI（T4/T5 框架与三页 + U1 演奏页「象牙琴房」重构 + U2 三页象牙换肤；M6 总预算 ≤900 行）====
 * 运行态标量登记（EEL2 未定义变量静默为 0，逐一登记；@gfx 线程专用，跨线程标量读容忍 P7/N8）：
 *   ui_inited（首帧门控）  ui_page（当前页 0..3）  ui_hit_count（本帧登记控件数）
 *   ui_sc / ui_ox / ui_oy（缩放与内容框偏移，每帧重算）  ui_cap_prev（上帧左键态）
 *   ui_dn_slot（按下捕获的命中 id，-1=无）  ui_dn_t / ui_rep_t（按下/上次连发时刻，秒，读内置 time_precise，I3）
 *   ui_ft_face / ui_ft_sz（字体缓存：面 0=Arial 槽1、1=Georgia 槽2 + 字号，任一变化才重设 gfx_setfont——U1 双字体槽）
 *   ui_dg_acc（诊断日志 type 词点缀标志 0/1：ui_dg_fmt 写、ui_page_diag 读——U2 三段分色绘制）
 *   ui_px / ui_py / ui_pw / ui_ph（踏板 lyre 绘制位与尺寸，页面设置后调 ui_draw_pedal——U1 侧视琴架踏板）
 * 串槽（U1 新增）：#ui_chbuf（逐字符绘制单字符缓冲，str_setlen/str_setchar 维护——B2 修复，官方串函数）
 *   / #ui_lsstr（逐字距源串，调用方先赋值再调 ui_draw_text_ls）
 * 串槽（U2 新增）：#ui_dgp（诊断日志行序号前缀「#N」）/ #ui_dgw（type 词）——三段分色绘制，余段仍走 #ui_lbuf
 * 命中区：g_ui_hit@2048[256] = 64 控件 × 4 字段 [x,y,w,h]（N-7）；控件 id 即动作 id，分发 switch 于 ui_act_fire；
 *   每页重建（ui_hit_clear 每帧清 64 槽 w 字段后随绘制随登记）：演奏页 14 / 高级页 18（页签4+LED4+行控件13）/
 *   诊断·说明书页 5（页签4+LED4）控件 ×4 槽 = 56/72/20/20 ≤ 256（U1：总开关改绘于标题行 LED，四页可点，
 *   演奏页控件数与 id 0–13 语义不变）；越界静默拒绝并返回 0。
 * 线程协议：@gfx 只读业务状态（st_held_total / st_auto_cc / cfg_ 镜像 / 快照 g_diag_snap、环形 g_diag、标量 diag_head——T5 诊断页）；
 *   参数修改全走 cfg_set_param（D1）；命令槽 slider13/14/15 直写不经 automate（D1/D19 例外）；
 *   恢复默认先 sliderchange(-1) 生成 undo 点再写 C03（D13，仅 @gfx 合法）。
 * 布局引擎（审核锚定 tests/T4坐标表.md）：等比缩放 ui_sc = min(gfx_w/UI_W0, gfx_h/UI_H0)，下限钳制 UI_SC_MIN；
 *   内容框居中偏移 ui_ox/ui_oy；全部坐标 = ui_ox + 设计值×ui_sc（设计基准 380×460；760×920 时恰为设计值×2）。
 *   背景三区（乌木/黄铜+毛毡分隔/象牙）全窗宽绘制、设计锚随内容框（U1，四页共享）。
 * 执行序：@gfx → ui_draw()：首帧门控 → 缩放/清 hit → 背景/标题/页签 → 页内容（随绘制随登记）→ 鼠标状态机。
 * 绘制基元（审核修复 B1/B2 + U1 渐变/字体）：文字 = gfx_setfont 设字号（槽1 Arial 中文 / 槽2 Georgia 衬线——
 *   标题/大数字/三页参数值等拉丁数字用，U2 三页数值接入衬线）+ gfx_r/g/b 设文字色（gfx_set 无字号/0xRRGGBB 形态，B1）；填充圆角矩形 =
 *   ui_roundrect_geom / ui_roundrect_fill（gfx_roundrect 第 6 参为抗锯齿标志、仅描边无填充，B2；描边一律 aa=1）；
 *   线性渐变 = ui_grad_v / ui_grad_h（原生 gfx_gradrect 一次调用——官方签名 15 参含第 8 位 alpha（B1 修复），
 *   C++ 侧填充非 EEL2 逐像素循环，每帧开销可忽略——U1 未用离屏缓冲，见坐标表 U1 节渐变说明）；
 *   踏板面圆角+垂直渐变组合 gfx_gradrect 单矩形无法表达（无圆角裁剪）→ 逐行 1px 矩形（每行一 gfx_rect，
 *   行色三停插值+圆形角内缩）。
 * 函数序（先声明后调用，叶子在前）：ui_set_rgb → ui_grad_v/ui_grad_h → ui_roundrect_geom → ui_roundrect_fill →
 *   ui_hit_clear → ui_reg → ui_hit_at → ui_is_repeat → ui_act_fire → ui_font_sel → ui_text_ls_width →
 *   ui_draw_text_ls → ui_draw_text_a → ui_draw_text → ui_draw_text_serif → ui_note_name → ui_pc_name → ui_dg_fmt →
 *   控件库（btn/tab/toggle/toggle2/stepper/stprow）→ ui_draw_pedal → ui_draw_pedstat →
 *   绘制帮助（bg/title/status/tabs）→ 页面（perf/adv/diag/manual）→ 帧函数。
 */

// 图元配色（0xRRGGBB → gfx_r/g/b 0..1 + alpha；全部 gfx 图元与文字色经此设色——B1：文字色即 gfx_r/g/b）
function ui_set_rgb(hex, alpha) (
  gfx_r = (hex & 0xFF0000) / 16711680;
  gfx_g = (hex & 0x00FF00) / 65280;
  gfx_b = (hex & 0x0000FF) / 255;
  gfx_a = alpha;
);

// 垂直线性渐变（U1：c1→c2 两停；原生 gfx_gradrect 一次调用——C++ 侧逐像素填充、非 EEL2 循环，
// 每帧两大底重绘开销可忽略，未用离屏缓冲，见坐标表 U1 节）；
// 签名（B1 修复，官方）：gfx_gradrect(x,y,w,h, r,g,b,a[, drdx,dgdx,dbdx,dadx, drdy,dgdy,dbdy,dady])
// ——alpha 为第 8 参，此处传当前 gfx_a 保持透明度语义；x 向四增量全 0，y 向走 drdy/dgdy/dbdy；
// 步进=(终−起)/(跨−1)，跨≤1 退化纯色矩形；c 用 0xRRGGBB 整数拆通道
function ui_grad_v(x, y, w, h, c1, c2) local(gv_r, gv_g, gv_b) (
  h <= 1 ? (
    ui_set_rgb(c2, gfx_a);
    gfx_rect(x, y, w, max(h, 0), 1);
  ) : (
    gv_r = (c1 & 0xFF0000) / 16711680;
    gv_g = (c1 & 0x00FF00) / 65280;
    gv_b = (c1 & 0x0000FF) / 255;
    gfx_gradrect(x, y, w, h, gv_r, gv_g, gv_b, gfx_a, 0, 0, 0, 0,
      ((c2 & 0xFF0000) / 16711680 - gv_r) / (h - 1),
      ((c2 & 0x00FF00) / 65280 - gv_g) / (h - 1),
      ((c2 & 0x0000FF) / 255 - gv_b) / (h - 1));
  );
);

// 水平线性渐变（U1：同 ui_grad_v，步进走 x 向；立柱/嵌线等横向金属件用；B1 签名同上——
// x 向走 drdx/dgdx/dbdx、dadx=0，y 向三增量全 0，alpha 传当前 gfx_a）
function ui_grad_h(x, y, w, h, c1, c2) local(gh_r, gh_g, gh_b) (
  w <= 1 ? (
    ui_set_rgb(c2, gfx_a);
    gfx_rect(x, y, max(w, 0), h, 1);
  ) : (
    gh_r = (c1 & 0xFF0000) / 16711680;
    gh_g = (c1 & 0x00FF00) / 65280;
    gh_b = (c1 & 0x0000FF) / 255;
    gfx_gradrect(x, y, w, h, gh_r, gh_g, gh_b, gfx_a,
      ((c2 & 0xFF0000) / 16711680 - gh_r) / (w - 1),
      ((c2 & 0x00FF00) / 65280 - gh_g) / (w - 1),
      ((c2 & 0x0000FF) / 255 - gh_b) / (w - 1),
      0, 0, 0);
  );
);

// 圆角矩形几何填充（B2 修复：gfx_roundrect 第 6 参为抗锯齿标志、只描边无填充——填充一律走本函数；
// 颜色/透明度用当前 gfx_r/g/b/a，调用方先设；中带两块 gfx_rect + 四角 gfx_circle；
// 四角圆参数 (1,1)：官方签名 gfx_circle(x,y,r[,fill,antialias])——fill 在前 antialias 在后，
// 旧写法 (0,1) 实为「空心描边圈」（用户实测四角露出象牙扇形）；(1,1) 在两种参数顺序解读下语义一致，
// 实心填充 + 抗锯齿平滑边缘；
// r 钳制 ≤ 半高——r=半高时四角圆重合，恰退化为胶囊/圆）
function ui_roundrect_geom(x, y, w, h, r) local(ug_r) (
  ug_r = r;
  ug_r > h*0.5 ? ( ug_r = h*0.5; ) : 0;
  gfx_rect(x, y + ug_r, w, h - ug_r*2, 1);            // 中部横带（全宽）
  gfx_rect(x + ug_r, y, w - ug_r*2, h, 1);            // 中部竖带（补上下角间区域）
  gfx_circle(x + ug_r, y + ug_r, ug_r, 1, 1);         // 四角（fill=1 + aa=1，参数顺序双保险）
  gfx_circle(x + w - ug_r, y + ug_r, ug_r, 1, 1);
  gfx_circle(x + ug_r, y + h - ug_r, ug_r, 1, 1);
  gfx_circle(x + w - ug_r, y + h - ug_r, ug_r, 1, 1);
);

// 填充圆角矩形（主题色 + 不透明；透明填充走 ui_set_rgb + ui_roundrect_geom，如踏板阴影）
function ui_roundrect_fill(x, y, w, h, r, color) (
  ui_set_rgb(color, 1);
  ui_roundrect_geom(x, y, w, h, r);
);

// 命中区清空（每帧重建起点；首帧初始化亦调用）：64 槽 w 字段清零=未登记，登记数归零
function ui_hit_clear() local(uc_c) (
  ui_hit_count = 0;
  uc_c = 0;
  while (uc_c < 64) (
    g_mem[g_ui_hit + (uc_c|0)*4 + 2] = 0;
    uc_c = uc_c + 1;
  );
);

// 命中登记（id 即动作 id）：写 [x,y,w,h] 四字段并计数；成功返回 1，越界静默拒绝返回 0
function ui_reg(id, x, y, w, h) (
  id >= 0 && id < 64 ? (
    g_mem[g_ui_hit + (id|0)*4 + 0] = x;
    g_mem[g_ui_hit + (id|0)*4 + 1] = y;
    g_mem[g_ui_hit + (id|0)*4 + 2] = w;
    g_mem[g_ui_hit + (id|0)*4 + 3] = h;
    ui_hit_count = ui_hit_count + 1;
    1;
  ) : 0;
);

// 命中测试：遍历本帧登记槽（屏幕坐标），返回命中控件 id，未命中 -1（重叠时后登记者胜；本页布局无重叠）
function ui_hit_at(mx, my) local(uh_i, uh_f) (
  uh_f = -1;
  uh_i = 0;
  while (uh_i < 64) (
    g_mem[g_ui_hit + (uh_i|0)*4 + 2] > 0
      && mx >= g_mem[g_ui_hit + (uh_i|0)*4 + 0]
      && mx < g_mem[g_ui_hit + (uh_i|0)*4 + 0] + g_mem[g_ui_hit + (uh_i|0)*4 + 2]
      && my >= g_mem[g_ui_hit + (uh_i|0)*4 + 1]
      && my < g_mem[g_ui_hit + (uh_i|0)*4 + 1] + g_mem[g_ui_hit + (uh_i|0)*4 + 3] ? (
      uh_f = uh_i;
    ) : 0;
    uh_i = uh_i + 1;
  );
  uh_f;
);

// 连发型控件判定（步进器钮：演奏页 4 钮 + T5 高级页 12 钮，按下即触发第一次 + 按住连发；按钮/开关/页签为抬起 fire）
function ui_is_repeat(id) (
  id == UI_A_BC_M || id == UI_A_BC_P || id == UI_A_TAIL_M || id == UI_A_TAIL_P
  || id == UI_A_GAP_M || id == UI_A_GAP_P || id == UI_A_HUM_M || id == UI_A_HUM_P
  || id == UI_A_WB_M || id == UI_A_WB_P || id == UI_A_WR_M || id == UI_A_WR_P
  || id == UI_A_SCOPE_M || id == UI_A_SCOPE_P || id == UI_A_CCT_M || id == UI_A_CCT_P ? 1 : 0;
);

// 动作分发（switch 语义）：参数类全走 cfg_set_param（idx=slider 编号，见 SDS §3）；步进类先算钳制新值、
// 与现值相同（端点）则跳过——N9：连发在端点不再触发 cfg_set_param/automate；
// 命令槽三钮直写（D1/D19，不经 automate）；恢复默认先 sliderchange(-1) 再写 C03（D13）
function ui_act_fire(id) local(af_nv) (
  id == UI_A_TAB0 ? ( ui_page = 0; )
  : id == UI_A_TAB1 ? ( ui_page = 1; )
  : id == UI_A_TAB2 ? ( ui_page = 2; )
  : id == UI_A_TAB3 ? ( ui_page = 3; )
  : id == UI_A_EN    ? ( cfg_set_param(1, cfg_enabled > 0 ? 0 : 1); )
  : id == UI_A_BC_M  ? ( af_nv = max(cfg_bass_ceil - UI_BC_STEP, 0); af_nv != cfg_bass_ceil ? ( cfg_set_param(2, af_nv); ) : 0; )
  : id == UI_A_BC_P  ? ( af_nv = min(cfg_bass_ceil + UI_BC_STEP, 127); af_nv != cfg_bass_ceil ? ( cfg_set_param(2, af_nv); ) : 0; )
  : id == UI_A_TAIL_M ? ( af_nv = max(cfg_tail_ms - UI_TAIL_STEP, 0); af_nv != cfg_tail_ms ? ( cfg_set_param(3, af_nv); ) : 0; )
  : id == UI_A_TAIL_P ? ( af_nv = min(cfg_tail_ms + UI_TAIL_STEP, 8000); af_nv != cfg_tail_ms ? ( cfg_set_param(3, af_nv); ) : 0; )
  : id == UI_A_CHORD ? ( cfg_set_param(4, cfg_chord > 0 ? 0 : 1); )
  : id == UI_A_OCT   ? ( cfg_set_param(5, cfg_ign_oct > 0 ? 0 : 1); )
  : id == UI_A_TAP   ? ( slider13 = 1; )                    // C01 换踏一次：命令槽直写
  : id == UI_A_REL   ? ( slider14 = 1; )                    // C02 释放踏板：命令槽直写
  : id == UI_A_RST   ? ( sliderchange(-1); slider15 = 1; )  // C03 恢复默认：先 undo 点再写槽（D13）
  // ---- T5 高级页（步进量=UI_ADV_*_STEP 同源常量；端点钳制后与现值同则跳过，N9）----
  : id == UI_A_GAP_M ? ( af_nv = max(cfg_gap_ms - UI_ADV_GAP_STEP, 0); af_nv != cfg_gap_ms ? ( cfg_set_param(6, af_nv); ) : 0; )
  : id == UI_A_GAP_P ? ( af_nv = min(cfg_gap_ms + UI_ADV_GAP_STEP, 100); af_nv != cfg_gap_ms ? ( cfg_set_param(6, af_nv); ) : 0; )
  : id == UI_A_HUM_M ? ( af_nv = max(cfg_hum_ms - UI_ADV_HUM_STEP, 0); af_nv != cfg_hum_ms ? ( cfg_set_param(7, af_nv); ) : 0; )
  : id == UI_A_HUM_P ? ( af_nv = min(cfg_hum_ms + UI_ADV_HUM_STEP, 50); af_nv != cfg_hum_ms ? ( cfg_set_param(7, af_nv); ) : 0; )
  : id == UI_A_WB_M  ? ( af_nv = max(cfg_win_bass_ms - UI_ADV_WIN_STEP, 0); af_nv != cfg_win_bass_ms ? ( cfg_set_param(8, af_nv); ) : 0; )
  : id == UI_A_WB_P  ? ( af_nv = min(cfg_win_bass_ms + UI_ADV_WIN_STEP, 500); af_nv != cfg_win_bass_ms ? ( cfg_set_param(8, af_nv); ) : 0; )
  : id == UI_A_WR_M  ? ( af_nv = max(cfg_win_rep_ms - UI_ADV_WIN_STEP, 0); af_nv != cfg_win_rep_ms ? ( cfg_set_param(9, af_nv); ) : 0; )
  : id == UI_A_WR_P  ? ( af_nv = min(cfg_win_rep_ms + UI_ADV_WIN_STEP, 500); af_nv != cfg_win_rep_ms ? ( cfg_set_param(9, af_nv); ) : 0; )
  : id == UI_A_REP   ? ( cfg_chord != 0 ? ( cfg_set_param(10, cfg_repeat_repedal > 0 ? 0 : 1); ) : 0; )   // 灰置守卫：cfg_chord==0 点击不生效（自检6 路径）
  : id == UI_A_SCOPE_M ? ( af_nv = max(cfg_ch_scope - UI_ADV_SCOPE_STEP, 0); af_nv != cfg_ch_scope ? ( cfg_set_param(11, af_nv); ) : 0; )
  : id == UI_A_SCOPE_P ? ( af_nv = min(cfg_ch_scope + UI_ADV_SCOPE_STEP, 16); af_nv != cfg_ch_scope ? ( cfg_set_param(11, af_nv); ) : 0; )
  : id == UI_A_CCT_M ? ( af_nv = max(slider12 - UI_ADV_CC_STEP, 0); af_nv != slider12 ? ( cfg_set_param(12, af_nv); ) : 0; )   // slider12 枚举索引无 cfg 镜像，@gfx 只读直读
  : id == UI_A_CCT_P ? ( af_nv = min(slider12 + UI_ADV_CC_STEP, 2); af_nv != slider12 ? ( cfg_set_param(12, af_nv); ) : 0; )
  : 0;
);

// 字体槽选择（U1：face 0=Arial 槽1（中文/正文，REAPER 字体回退渲染）/ 1=Georgia 槽2（衬线：标题/大数字/拉丁字距串））；
// 缓存键 = 面+字号（ui_ft_face/ui_ft_sz）——换面或换字号才重设 gfx_setfont，双字体槽共用一套缓存（U1 自检7）
function ui_font_sel(face, size) (
  face != ui_ft_face || size != ui_ft_sz ? (
    face == 0 ? gfx_setfont(1, "Arial", size) : gfx_setfont(2, "Georgia", size);
    ui_ft_face = face;
    ui_ft_sz = size;
  ) : 0;
);

// 逐字符宽度合计（U1 拉丁字距；串经全局槽 #ui_lsstr 传入；B2 修复：官方函数 str_getchar 读字符——
// 无 type 参时按字节偏移读取，本处串均为纯 ASCII、字节序=字符序；仅限 ASCII（多字节请传字符级串）；
// 衬线槽；长度钳 32 防病态串）
function ui_text_ls_width(size, gap) local(lw_n, lw_i, lw_w, lw_h, lw_sum, lw_c) (
  ui_font_sel(1, size*ui_sc);
  lw_n = strlen(#ui_lsstr);
  lw_n > 32 ? ( lw_n = 32; ) : 0;
  lw_sum = 0;
  lw_i = 0;
  while (lw_i < lw_n) (
    lw_c = str_getchar(#ui_lsstr, lw_i);
    str_setlen(#ui_chbuf, 1);                          // 置长 1（官方：增长以空格填充）——保证 setchar 偏移 0 在界内
    str_setchar(#ui_chbuf, 0, lw_c);                   // 写字节 0 → 单字符缓冲（NUL 终止由串机制维护）
    gfx_measurestr(#ui_chbuf, lw_w, lw_h);
    lw_sum = lw_sum + lw_w + gap*ui_sc;
    lw_i = lw_i + 1;
  );
  lw_sum - gap*ui_sc;                                // 末字符后不计字距
);

// 逐字符带字距绘制（U1：align 0=左/1=中/2=右；串在 #ui_lsstr；衬线槽；仅 ASCII；
// alpha 形参（I1：副题/ON·OFF 传 0.55，其余 1），绘制后恢复 gfx_a=1）
function ui_draw_text_ls(x, y, size, color, align, gap, alpha) local(ls_n, ls_i, ls_w, ls_h, ls_sum, ls_cx, ls_c) (
  ls_sum = ui_text_ls_width(size, gap);
  ui_set_rgb(color, alpha);
  ls_n = strlen(#ui_lsstr);
  ls_n > 32 ? ( ls_n = 32; ) : 0;
  ls_cx = x + (align == 1 ? ls_sum*-0.5 : align == 2 ? ls_sum*-1 : 0);
  ls_i = 0;
  while (ls_i < ls_n) (
    ls_c = str_getchar(#ui_lsstr, ls_i);
    str_setlen(#ui_chbuf, 1);
    str_setchar(#ui_chbuf, 0, ls_c);
    gfx_measurestr(#ui_chbuf, ls_w, ls_h);
    gfx_x = ls_cx;
    gfx_y = y;
    gfx_printf("%s", #ui_chbuf);
    ls_cx = ls_cx + ls_w + gap*ui_sc;
    ls_i = ls_i + 1;
  );
  gfx_a = 1;                                         // 恢复环境 alpha（I1：透明文字绘制后不复溢）
);

// 文字绘制帮助·带 alpha（U1 I1：mockup opacity 分层——未激活页签 .62/卡标签·单位 .6 经此传入；
// align：0=左对齐于 x、1=以 x 居中、2=右对齐于 x；size=设计字号，内部乘 ui_sc；
// B1 修复：gfx_set 无字号/0xRRGGBB 形态 → 字号/字体走 ui_font_sel（Arial 槽1，中文由 REAPER 字体回退渲染），
// 颜色走图元色 gfx_r/g/b（即文字色），alpha 经 gfx_a 且绘制后恢复 1；字号带缓存 ui_ft_face/ui_ft_sz；
// 每次绘制重新格式化输出——EEL2 串槽复用安全）
function ui_draw_text_a(x, y, size, color, text, align, alpha) local(ut_w, ut_h, ut_sz) (
  ut_sz = size * ui_sc;
  ui_font_sel(0, ut_sz);
  ui_set_rgb(color, alpha);
  align != 0 ? ( gfx_measurestr(text, ut_w, ut_h); ) : 0;
  gfx_x = x + (align == 1 ? ut_w * -0.5 : align == 2 ? ut_w * -1 : 0);
  gfx_y = y;
  gfx_printf("%s", text);
  gfx_a = 1;                                         // 恢复环境 alpha（I1：透明文字绘制后不复溢）
);

// 文字绘制帮助（全量程默认 alpha=1；U2 三页换肤后仍为本入口的 α=1 便捷形态，签名不变）
function ui_draw_text(x, y, size, color, text, align) (
  ui_draw_text_a(x, y, size, color, text, align, 1);
);

// 衬线文字（U1：Georgia 槽 2；标题/大数字/拉丁字距串用；中文一律走 ui_draw_text 原字体槽）
function ui_draw_text_serif(x, y, size, color, text, align) local(ut_w, ut_h, ut_sz) (
  ut_sz = size * ui_sc;
  ui_font_sel(1, ut_sz);
  ui_set_rgb(color, 1);
  align != 0 ? ( gfx_measurestr(text, ut_w, ut_h); ) : 0;
  gfx_x = x + (align == 1 ? ut_w * -0.5 : align == 2 ? ut_w * -1 : 0);
  gfx_y = y;
  gfx_printf("%s", text);
);

// 音名派生（N-4：复用 #nn0..#nn11 + 算术）：结果写全局槽 #ui_notebuf，调用方以 %s 输出；
// 八度用 floor 而非向零取整（避免 note<12 时差 1，如 note=11 → B-1）
function ui_note_name(note) local(un_pc, un_oct) (
  un_pc = note % 12;
  un_oct = floor(note / 12) - 1;
  un_pc == 0  ? sprintf(#ui_notebuf, "%s%d", #nn0,  un_oct)
  : un_pc == 1  ? sprintf(#ui_notebuf, "%s%d", #nn1,  un_oct)
  : un_pc == 2  ? sprintf(#ui_notebuf, "%s%d", #nn2,  un_oct)
  : un_pc == 3  ? sprintf(#ui_notebuf, "%s%d", #nn3,  un_oct)
  : un_pc == 4  ? sprintf(#ui_notebuf, "%s%d", #nn4,  un_oct)
  : un_pc == 5  ? sprintf(#ui_notebuf, "%s%d", #nn5,  un_oct)
  : un_pc == 6  ? sprintf(#ui_notebuf, "%s%d", #nn6,  un_oct)
  : un_pc == 7  ? sprintf(#ui_notebuf, "%s%d", #nn7,  un_oct)
  : un_pc == 8  ? sprintf(#ui_notebuf, "%s%d", #nn8,  un_oct)
  : un_pc == 9  ? sprintf(#ui_notebuf, "%s%d", #nn9,  un_oct)
  : un_pc == 10 ? sprintf(#ui_notebuf, "%s%d", #nn10, un_oct)
  : sprintf(#ui_notebuf, "%s%d", #nn11, un_oct);
);

// pc 音名（T5 诊断页低音和声行用）：0..11 → "C".."B"（不带八度），写 #ui_pcbuf（复用 N-4 十二音名串）
function ui_pc_name(pc) local(pn_s) (
  pc == 0  ? ( pn_s = #nn0; )  : pc == 1  ? ( pn_s = #nn1; )  : pc == 2  ? ( pn_s = #nn2; )  : pc == 3  ? ( pn_s = #nn3; )
  : pc == 4  ? ( pn_s = #nn4; )  : pc == 5  ? ( pn_s = #nn5; )  : pc == 6  ? ( pn_s = #nn6; )  : pc == 7  ? ( pn_s = #nn7; )
  : pc == 8  ? ( pn_s = #nn8; )  : pc == 9  ? ( pn_s = #nn9; )  : pc == 10 ? ( pn_s = #nn10; ) : ( pn_s = #nn11; );
  sprintf(#ui_pcbuf, "%s", pn_s);
);

// 诊断事件行格式化（T5；D20 type → 短文案；U2 改三段输出供诊断页分色绘制）：
//   段1 #ui_dgp = "#N " 序号前缀（恒墨字）；段2 #ui_dgw = type 词；段3 #ui_lbuf = 余段（type4 为空串）；
//   ui_dg_acc = 1 当 type∈{0,1,2}（踩/抬/换踏 → type 词毛毡红点缀，U2 克制规则；其余墨字）；
//   三段拼接结果与 T5 旧版整行逐字符一致（分段处恰为原空格分界）。
// type 语义（D20）：0/1 踩/抬 a=ch b=意图值；2 换踏 b=note+kind*1000 → kind=floor(b/1000)（1 低音/2 重复/3 按钮）、
//   note=b%1000；3 硬件 a=ch b=值；4 复位 a=reason（1=关沿 2=CC120/123；b=t_abs 不显示）；5 挂起 a=ch（命令槽路径=-1
//   → 余段「--」）b=翻转后新值；6 重同步 a=目标通道 b=合成值。解码用 floor/% 而非 |0（D10：|0 仅允许数组下标）
function ui_dg_fmt(seq, type, a, b) local(df_k, df_n, df_s) (
  sprintf(#ui_dgp, "#%d ", seq);                     // 段1 序号前缀
  ui_dg_acc = type < 3 ? 1 : 0;                      // 踩/抬/换踏 → type 词点缀（U2）
  type == 0 ? ( df_s = #str_dg_t0; sprintf(#ui_lbuf, " ch%d %d", a, b); )
  : type == 1 ? ( df_s = #str_dg_t1; sprintf(#ui_lbuf, " ch%d %d", a, b); )
  : type == 2 ? (
      df_k = floor(b / 1000);                          // kind（非下标语境禁 |0 → floor）
      df_n = b % 1000;                                 // note
      df_k == 1 ? ( df_s = #str_dg_k1; ) : df_k == 2 ? ( df_s = #str_dg_k2; ) : ( df_s = #str_dg_k3; );
      sprintf(#ui_lbuf, " ch%d %s n%d", a, df_s, df_n);   // 余段先拼（df_s 暂为 kind 词）
      df_s = #str_dg_t2;                               // type 词 =「换踏」（kind 词留在余段）
    )
  : type == 3 ? ( df_s = #str_dg_t3; sprintf(#ui_lbuf, " ch%d %d", a, b); )
  : type == 4 ? (
      a == 1 ? ( df_s = #str_dg_t4a; ) : ( df_s = #str_dg_t4b; );
      #ui_lbuf = "";                                   // 复位行无余段
    )
  : type == 5 ? (
      b != 0 ? ( df_s = #str_dg_t5; ) : ( df_s = #str_dg_t5r; );
      a < 0 ? sprintf(#ui_lbuf, " --") : sprintf(#ui_lbuf, " ch%d", a);   // N1：命令槽路径 a=-1 → 「--」
    )
  : ( df_s = #str_dg_t6; sprintf(#ui_lbuf, " ch%d %d", a, b); );
  sprintf(#ui_dgw, "%s", df_s);                      // 段2 type 词
);

// 控件：按钮（U1 象牙主题：深棕底 + 乌木描边 + 米白字，圆角 6；返回是否登记成功）
function ui_widget_btn(id, x, y, w, h, label) local(wb_r) (
  wb_r = ui_reg(id, x, y, w, h);
  ui_roundrect_fill(x, y, w, h, 6*ui_sc, UI_C_STEPBG);   // 底（B2：填充走 ui_roundrect_fill）
  ui_set_rgb(UI_C_BTNEDGE, 1);
  gfx_roundrect(x, y, w, h, 6*ui_sc, 1);                 // 描边（aa=1）
  ui_draw_text(x + w*0.5, y + (h - 11*ui_sc)*0.5, UI_FS_SYM2, UI_C_TITLE, label, 1);
  wb_r;
);

// 控件：页签（U1：激活=黄铜 16% 底 + 米金文字；未激活=暗金文字；圆角 4，四页共享 chrome）
function ui_widget_tab(id, x, y, w, h, label, active) (
  ui_reg(id, x, y, w, h);
  active != 0 ? (
    ui_set_rgb(UI_C_BRASS, 0.16);
    ui_roundrect_geom(x, y, w, h, 4*ui_sc);              // 页签底（黄铜 16%，B2 几何填充）
    ui_draw_text(x + w*0.5, y + (h - 11*ui_sc)*0.5, UI_FS_TAB, UI_C_TABON, label, 1);
  ) : (
    ui_draw_text_a(x + w*0.5, y + (h - 11*ui_sc)*0.5, UI_FS_TAB, UI_C_TABTXT, label, 1, 0.62);   // .tabs span opacity .62
  );
);

// 控件：开关（U1 象牙主题，演奏页用；行高 UI_TG_H=28：行底 深棕 6% + 描边 #cdb98d + 墨字；
// 右端滑块 26×14：关=轨道 #c8b48a/旋钮 #2b2016，开=轨道 #2b2016/旋钮 #f0e6cf；卡内偏移 10 为控件库内部小偏移）
function ui_widget_toggle(id, x, y, w, label, val) local(wt_tx, wt_ty, wt_tw, wt_th, wt_kx) (
  ui_reg(id, x, y, w, UI_TG_H*ui_sc);
  ui_set_rgb(UI_C_STEPBG, 0.06);
  ui_roundrect_geom(x, y, w, UI_TG_H*ui_sc, 7*ui_sc);                    // 行底（深棕 6%，B2 几何填充）
  ui_set_rgb(UI_C_IVEDGE, 1);
  gfx_roundrect(x, y, w, UI_TG_H*ui_sc, 7*ui_sc, 1);                     // 描边（aa=1）
  ui_draw_text(x + 10*ui_sc, y + (UI_TG_H*ui_sc - 12*ui_sc)*0.5, UI_FS_TGL, UI_C_INK, label, 0);
  wt_tw = 26*ui_sc;
  wt_th = 14*ui_sc;
  wt_tx = x + w - wt_tw - 10*ui_sc;
  wt_ty = y + (UI_TG_H*ui_sc - wt_th)*0.5;
  ui_roundrect_fill(wt_tx, wt_ty, wt_tw, wt_th, wt_th*0.5, val > 0 ? UI_C_STEPBG : UI_C_TGOFF);   // 轨道（胶囊）
  val > 0 ? ( wt_kx = wt_tx + wt_tw - 12*ui_sc; ) : ( wt_kx = wt_tx + 2*ui_sc; );
  ui_roundrect_fill(wt_kx, wt_ty + 2*ui_sc, 10*ui_sc, 10*ui_sc, 5*ui_sc,
    val > 0 ? UI_C_TITLE : UI_C_STEPBG);                                 // 旋钮（圆）
);

// 控件：开关·带禁用态（T5 高级页重复音重踏行用）：on=0 灰置（U1 禁用态配色：轨道 #c8b48a/
// 旋钮 #efe9da/文字 #8a7452；旋钮位置仍反映存储值，便于恢复和弦保护后可见原状态）；
// U2 象牙换肤：行卡=rgba(255,252,242,.65)+#cdb98d 边（同演奏页）；开态文字墨字、轨道/旋钮同演奏页
// toggle（开=深棕轨/米白钮，关=驼轨/深棕钮）；几何独立（轨道 34×14/旋钮 12，与演奏页 26/10 不同——T5 沿用）；
// 命中恒登记——cfg_chord==0 时点击能否生效由 ui_act_fire 之 UI_A_REP 分支二次守卫（不 fire，自检6 路径）
function ui_widget_toggle2(id, x, y, w, label, val, on) local(wt_tx, wt_ty, wt_tw, wt_th, wt_kx) (
  ui_reg(id, x, y, w, UI_TGL_H*ui_sc);
  ui_set_rgb(UI_C_IVCARD, 0.65);
  ui_roundrect_geom(x, y, w, UI_TGL_H*ui_sc, 6*ui_sc);                   // 行卡底（半透明米白，B2 几何填充）
  ui_set_rgb(UI_C_IVEDGE, 1);
  gfx_roundrect(x, y, w, UI_TGL_H*ui_sc, 6*ui_sc, 1);                    // 描边（aa=1）
  on != 0 ? ui_draw_text(x + 6*ui_sc, y + (UI_TGL_H*ui_sc - 11*ui_sc)*0.5, UI_FS_LBL, UI_C_INK, label, 0)
          : ui_draw_text(x + 6*ui_sc, y + (UI_TGL_H*ui_sc - 11*ui_sc)*0.5, UI_FS_LBL, UI_C_IVUNIT, label, 0);
  wt_tw = 34*ui_sc;
  wt_th = 14*ui_sc;
  wt_tx = x + w - wt_tw - 6*ui_sc;
  wt_ty = y + (UI_TGL_H*ui_sc - wt_th)*0.5;
  on != 0 ? (
    ui_roundrect_fill(wt_tx, wt_ty, wt_tw, wt_th, wt_th*0.5, val > 0 ? UI_C_STEPBG : UI_C_TGOFF);   // 轨道（胶囊，同演奏页 toggle）
    val > 0 ? ( wt_kx = wt_tx + wt_tw - 12*ui_sc - ui_sc; ) : ( wt_kx = wt_tx + ui_sc; );
    ui_roundrect_fill(wt_kx, wt_ty + ui_sc, 12*ui_sc, 12*ui_sc, 6*ui_sc,
      val > 0 ? UI_C_TITLE : UI_C_STEPBG);                               // 旋钮（圆，两态同演奏页 toggle）
  ) : (
    ui_roundrect_fill(wt_tx, wt_ty, wt_tw, wt_th, wt_th*0.5, UI_C_TGOFF);   // 灰置轨道（象牙禁用 #c8b48a）
    val > 0 ? ( wt_kx = wt_tx + wt_tw - 12*ui_sc - ui_sc; ) : ( wt_kx = wt_tx + ui_sc; );
    ui_roundrect_fill(wt_kx, wt_ty + ui_sc, 12*ui_sc, 12*ui_sc, 6*ui_sc, UI_C_KNOBDIS);   // 灰置旋钮 #efe9da
  );
);

// 控件：象牙参数卡（U1，演奏页用；id=−钮、id+1=+钮；卡 171×74：标签 9.5 棕 / 大数字 Georgia 25 墨 /
// 单位 9.5 深金（#ui_unit=值后缀独立串，基线近似对齐）；步进小钮 22×16 左列并排（间距 6）；
// vstep 为签名占位——步进量在 ui_act_fire 以同源常量 UI_BC_STEP/UI_TAIL_STEP 生效；
// 卡内偏移 10/7/19/31/51 为控件库内部小偏移）
function ui_widget_stepper(id, x, y, w, label, val, vmin, vmax, vstep) local(ws_nw, ws_nh, ws_bx, ws_by, ws_bw, ws_bh) (
  ui_set_rgb(UI_C_IVCARD, 0.65);
  ui_roundrect_geom(x, y, w, UI_CARD_H*ui_sc, 7*ui_sc);              // 卡底（半透明米白，B2 几何填充）
  ui_set_rgb(UI_C_IVEDGE, 1);
  gfx_roundrect(x, y, w, UI_CARD_H*ui_sc, 7*ui_sc, 1);               // 描边（aa=1）
  ui_draw_text_a(x + 10*ui_sc, y + 7*ui_sc, UI_FS_SUB2, UI_C_IVLBL, label, 0, 0.6);   // .plabel opacity .6
  sprintf(#ui_valbuf, "%d", val);                    // 数字串每次绘制重新格式化（单位另绘）
  ui_draw_text_serif(x + 10*ui_sc, y + 19*ui_sc, UI_FS_NUM2, UI_C_INK, #ui_valbuf, 0);
  gfx_measurestr(#ui_valbuf, ws_nw, ws_nh);                          // 衬线槽已激活 → 量数字宽推单位位
  ui_draw_text_a(x + 10*ui_sc + ws_nw + 6*ui_sc, y + 31*ui_sc, UI_FS_SUB2, UI_C_IVUNIT, #ui_unit, 0, 0.6);   // .punit opacity .6
  ws_bw = UI_STP2_W*ui_sc;
  ws_bh = UI_STP2_H*ui_sc;
  ws_by = y + 51*ui_sc;
  ws_bx = x + 10*ui_sc;                              // − 小钮
  ui_reg(id, ws_bx, ws_by, ws_bw, ws_bh);
  ui_roundrect_fill(ws_bx, ws_by, ws_bw, ws_bh, 4*ui_sc, UI_C_STEPBG);
  ui_draw_text(ws_bx + ws_bw*0.5, ws_by + (ws_bh - 11*ui_sc)*0.5, UI_FS_SYM2, UI_C_TITLE, #str_minus, 1);
  ws_bx = ws_bx + ws_bw + 6*ui_sc;                   // + 小钮（− 右侧 6 间距）
  ui_reg(id + 1, ws_bx, ws_by, ws_bw, ws_bh);
  ui_roundrect_fill(ws_bx, ws_by, ws_bw, ws_bh, 4*ui_sc, UI_C_STEPBG);
  ui_draw_text(ws_bx + ws_bw*0.5, ws_by + (ws_bh - 11*ui_sc)*0.5, UI_FS_SYM2, UI_C_TITLE, #str_plus, 1);
);

// 控件：紧凑步进行（T5 高级页 7 行用）：行卡（UI_TGL_H 高）+ 左标签 + 右对齐值文本 + 右端 −/+ 两钮；
// 命中 = 两钮（id=−、id+1=+，连发型由 ui_is_repeat 判定），行卡本体不可点；
// U2 象牙换肤：行卡=rgba(255,252,242,.65)+#cdb98d 边；标签/值墨字；值文字 serif!=0 时走 Georgia 衬线槽
// （与演奏页大数字同字体；serif=0 供 CJK 值「全部/通道 N」沿用原字体槽——Georgia 无 CJK 字形，U1 约定）；
// −/+ 钮=深棕底+乌木描边+米白字（同演奏页三按钮语言，尺寸 UI_STP_W/H 沿用）；
// 步进量不走形参——由 ui_act_fire 以同源常量 UI_ADV_*_STEP 生效（与 T4 ui_widget_stepper 之 vstep 占位
// 同一机制；本控件不设 vstep 形参即无占位，见 T5 汇报偏离记录）；行内偏移 6/98/46/92 为控件库内部小偏移
function ui_widget_stprow(id, x, y, w, label, valtext, serif) local(sr_bw, sr_bh, sr_bx) (
  ui_set_rgb(UI_C_IVCARD, 0.65);
  ui_roundrect_geom(x, y, w, UI_TGL_H*ui_sc, 6*ui_sc);                   // 行卡底（半透明米白，B2 几何填充）
  ui_set_rgb(UI_C_IVEDGE, 1);
  gfx_roundrect(x, y, w, UI_TGL_H*ui_sc, 6*ui_sc, 1);                    // 描边（aa=1）
  ui_draw_text(x + 6*ui_sc, y + (UI_TGL_H*ui_sc - 11*ui_sc)*0.5, UI_FS_LBL, UI_C_INK, label, 0);
  serif != 0 ? ui_draw_text_serif(x + w - 98*ui_sc, y + (UI_TGL_H*ui_sc - 12*ui_sc)*0.5, UI_FS_TXT, UI_C_INK, valtext, 2)
              : ui_draw_text(x + w - 98*ui_sc, y + (UI_TGL_H*ui_sc - 12*ui_sc)*0.5, UI_FS_TXT, UI_C_INK, valtext, 2);
  sr_bw = UI_STP_W*ui_sc;
  sr_bh = UI_STP_H*ui_sc;
  sr_bx = x + w - 46*ui_sc;                                              // + 钮（左缘偏移 46 → 右缘 x+w−6，B1 修复：勿再减 sr_bw）
  ui_reg(id + 1, sr_bx, y, sr_bw, sr_bh);
  ui_roundrect_fill(sr_bx, y, sr_bw, sr_bh, 5*ui_sc, UI_C_STEPBG);
  ui_set_rgb(UI_C_BTNEDGE, 1);
  gfx_roundrect(sr_bx, y, sr_bw, sr_bh, 5*ui_sc, 1);
  ui_draw_text(sr_bx + sr_bw*0.5, y + (sr_bh - 14*ui_sc)*0.5, UI_FS_SYM, UI_C_TITLE, #str_plus, 1);
  sr_bx = sr_bx - 6*ui_sc - sr_bw;                                       // − 钮（+ 左侧 6 间距）
  ui_reg(id, sr_bx, y, sr_bw, sr_bh);
  ui_roundrect_fill(sr_bx, y, sr_bw, sr_bh, 5*ui_sc, UI_C_STEPBG);
  ui_set_rgb(UI_C_BTNEDGE, 1);
  gfx_roundrect(sr_bx, y, sr_bw, sr_bh, 5*ui_sc, 1);
  ui_draw_text(sr_bx + sr_bw*0.5, y + (sr_bh - 14*ui_sc)*0.5, UI_FS_SYM, UI_C_TITLE, #str_minus, 1);
);

// 侧视琴架踏板（U1 核心重绘；lyre 120×118，原点 ui_px/ui_py，设计几何全在 lyre 内；state 非 0=踩下：
// 仅板面下沉 9 设计px + 状态字变色——阴影两态恒定（审核 I2：删除规格外的 ×0.93/α.38/+1px）；
// 无旋转——mockup 的 ±9° 杆倾角用斜线段、2.5° 板面倾角略去，偏离记录）：
// 两根斜拉银杆（6×52，顶 6：6 条 1px 斜线并排成杆宽，逐条配色近似 90° 三停渐变；±9°→顶端水平内收 8.2）+
// 中央立柱 8×44（横渐变三停）+ 椭圆阴影 110×7（逐行 1px 矩形）+ 踏板面 92×26 圆角 12/9
// （逐行 1px 矩形：行色=垂直三停插值+圆形角内缩——圆角与渐变 gfx_gradrect 单矩形无法同表，见 M6 头注释）+
// 黄铜嵌线 68×3（水平三停）
function ui_draw_pedal(state) local(pd_i, pd_n, pd_dy, pd_hw, pd_t, pd_ins, pd_plx, pd_ply, pd_y,
                                    pd_r1, pd_g1, pd_b1, pd_r2, pd_g2, pd_b2, pd_r3, pd_g3, pd_b3) (
  // ---- 斜拉银杆 ×2（底左 x=26 / 镜像 88，底 y=58；顶端内收 8.2≈52×tan9°，倾向中柱）----
  pd_y = ui_py + 6*ui_sc;
  pd_i = 0;
  while (pd_i < 6) (
    pd_i == 0 ? ui_set_rgb(0x8F8F94, 1)
    : pd_i == 1 ? ui_set_rgb(0xB9B9BF, 1)
    : pd_i <= 3 ? ui_set_rgb(0xD9D9DE, 1)
    : pd_i == 4 ? ui_set_rgb(0x9D9DA4, 1)
    : ui_set_rgb(0x7C7C83, 1);
    gfx_line(ui_px + (26 + pd_i)*ui_sc, ui_py + 58*ui_sc, ui_px + (34.2 + pd_i)*ui_sc, pd_y);
    gfx_line(ui_px + (88 + pd_i)*ui_sc, ui_py + 58*ui_sc, ui_px + (79.8 + pd_i)*ui_sc, pd_y);
    pd_i = pd_i + 1;
  );
  // ---- 中央立柱 8×44（90° 三停 #9c9ca0→#e4e4e8 45%→#83838a：3.6+4.4 两段）----
  ui_grad_h(ui_px + 56*ui_sc, ui_py, 3.6*ui_sc, 44*ui_sc, UI_C_STEM1, UI_C_STEM2);
  ui_grad_h(ui_px + 59.6*ui_sc, ui_py, 4.4*ui_sc, 44*ui_sc, UI_C_STEM2, UI_C_STEM3);
  // ---- 椭圆阴影 110×7（bottom −4 → 顶 115；两态恒定——审核 I2）----
  pd_n = floor(7*ui_sc);
  pd_y = ui_py + 115*ui_sc;
  pd_i = 0;
  while (pd_i < pd_n) (
    pd_dy = (pd_i + 0.5)/pd_n - 0.5;
    pd_hw = 55*ui_sc*sqrt(max(0, 1 - 4*pd_dy*pd_dy));
    gfx_r = 0; gfx_g = 0; gfx_b = 0;
    gfx_a = 0.5;
    gfx_rect(ui_px + 60*ui_sc - pd_hw, pd_y + pd_i, pd_hw*2, 1, 1);
    pd_i = pd_i + 1;
  );
  // ---- 踏板面 92×26 圆角 12/9（顶 90；踩下沉 9 → 99，板底最深 171 < 黄铜线 172）----
  pd_plx = ui_px + 14*ui_sc;
  pd_ply = ui_py + (90 + (state != 0 ? 9 : 0))*ui_sc;
  pd_n = floor(26*ui_sc);
  pd_r1 = (UI_C_PLATE1 & 0xFF0000) / 16711680;         // 三停通道预拆（每帧一次，行插值直接用）
  pd_g1 = (UI_C_PLATE1 & 0x00FF00) / 65280;
  pd_b1 = (UI_C_PLATE1 & 0x0000FF) / 255;
  pd_r2 = (UI_C_PLATE2 & 0xFF0000) / 16711680;
  pd_g2 = (UI_C_PLATE2 & 0x00FF00) / 65280;
  pd_b2 = (UI_C_PLATE2 & 0x0000FF) / 255;
  pd_r3 = (UI_C_PLATE3 & 0xFF0000) / 16711680;
  pd_g3 = (UI_C_PLATE3 & 0x00FF00) / 65280;
  pd_b3 = (UI_C_PLATE3 & 0x0000FF) / 255;
  pd_i = 0;
  while (pd_i < pd_n) (
    pd_t = (pd_i + 0.5)/pd_n;                          // 行色：三停插值 0→#eceff2、45%→#b9bcc2、100%→#77787f
    pd_t < 0.45 ? (
      pd_t = pd_t/0.45;
      gfx_r = pd_r1 + (pd_r2 - pd_r1)*pd_t;
      gfx_g = pd_g1 + (pd_g2 - pd_g1)*pd_t;
      gfx_b = pd_b1 + (pd_b2 - pd_b1)*pd_t;
    ) : (
      pd_t = (pd_t - 0.45)/0.55;
      gfx_r = pd_r2 + (pd_r3 - pd_r2)*pd_t;
      gfx_g = pd_g2 + (pd_g3 - pd_g2)*pd_t;
      gfx_b = pd_b2 + (pd_b3 - pd_b2)*pd_t;
    );
    gfx_a = 1;
    pd_dy = pd_i + 0.5;                                // 圆形角内缩（顶 r12 / 底 r9）
    pd_ins = 0;
    pd_dy < 12*ui_sc ? ( pd_ins = 12*ui_sc - sqrt((12*ui_sc)*(12*ui_sc) - (12*ui_sc - pd_dy)*(12*ui_sc - pd_dy)); )
    : pd_dy > 17*ui_sc ? ( pd_ins = 9*ui_sc - sqrt((9*ui_sc)*(9*ui_sc) - (pd_dy - 17*ui_sc)*(pd_dy - 17*ui_sc)); ) : 0;
    gfx_rect(pd_plx + pd_ins, pd_ply + pd_i, 92*ui_sc - pd_ins*2, 1, 1);
    pd_i = pd_i + 1;
  );
  ui_set_rgb(UI_C_PLATEDG, 1);                         // 板面描边（单半径取顶 12/底 9 均值 10.5）
  gfx_roundrect(pd_plx, pd_ply, 92*ui_sc, 26*ui_sc, 10.5*ui_sc, 1);
  // ---- 黄铜嵌线（左 12/右 12/顶 5/高 3，水平三停 34+34）----
  ui_grad_h(pd_plx + 12*ui_sc, pd_ply + 5*ui_sc, 34*ui_sc, 3*ui_sc, UI_C_BRASS, UI_C_INLAY2);
  ui_grad_h(pd_plx + 46*ui_sc, pd_ply + 5*ui_sc, 34*ui_sc, 3*ui_sc, UI_C_INLAY2, UI_C_BRASS);
);

// 踏板状态字（U1，乌木区右上、右对齐 x_right）：SUSTAIN（衬线·字距 2）+「 · 」（衬线）+ 踩下/释放（原字体槽）；
// 释放=#c9a05a / 踩下=#a03a34（冻结 token）；三段总宽先量后绘实现右对齐
function ui_draw_pedstat(x_right, y, down) local(ps_w1, ps_w2, ps_w3, ps_x, ps_txt, ps_col) (
  ps_col = down != 0 ? UI_C_FELT : UI_C_LEDON;
  down != 0 ? ( ps_txt = #str_pd; ) : ( ps_txt = #str_prel; );
  #ui_lsstr = #str_pstat;
  ps_w1 = ui_text_ls_width(UI_FS_PEDST, 2);
  ui_font_sel(1, UI_FS_PEDST*ui_sc);
  gfx_measurestr(#str_psep, ps_w2, ps_x);
  ui_font_sel(0, UI_FS_PEDST*ui_sc);
  gfx_measurestr(ps_txt, ps_w3, ps_x);
  ps_x = x_right - (ps_w1 + ps_w2 + ps_w3);
  ui_draw_text_ls(ps_x, y, UI_FS_PEDST, ps_col, 0, 2, 1);        // .pstat 无 opacity → 1
  ui_draw_text_serif(ps_x + ps_w1, y, UI_FS_PEDST, ps_col, #str_psep, 0);
  ui_draw_text(ps_x + ps_w1 + ps_w2, y, UI_FS_PEDST, ps_col, ps_txt, 0);
);

// 全局背景（U1：乌木渐变 + 黄铜/毛毡分隔 + 象牙渐变；全窗宽绘制、设计锚随内容框——四页共享 chrome；
// 黄铜 2px（172..174）+ 毛毡 2px（174..176）紧贴；象牙自 176 至窗底（284，mockup 282+满窗余量，偏离记录）；
// 乌木中停固定在设计 y=100（0.58×172≈100））
function ui_draw_bg() local(bg_bs, bg_iv, bg_mid) (
  bg_bs = ui_oy + UI_Y_SPLIT*ui_sc;
  bg_iv = ui_oy + UI_Y_IVORY*ui_sc;
  bg_mid = ui_oy + 100*ui_sc;
  ui_set_rgb(UI_C_EBONY1, 1);
  ui_grad_v(0, 0, gfx_w, bg_mid, UI_C_EBONY1, UI_C_EBONY2);
  ui_grad_v(0, bg_mid, gfx_w, bg_bs - bg_mid, UI_C_EBONY2, UI_C_EBONY3);
  ui_set_rgb(UI_C_BRASS, 1);
  gfx_rect(0, bg_bs, gfx_w, 2*ui_sc, 1);
  ui_set_rgb(UI_C_FELT, 1);
  gfx_rect(0, bg_bs + 2*ui_sc, gfx_w, 2*ui_sc, 1);
  ui_set_rgb(UI_C_IVORY1, 1);
  ui_grad_v(0, bg_iv, gfx_w, gfx_h - bg_iv, UI_C_IVORY1, UI_C_IVORY2);
  ui_set_rgb(UI_C_BRASS, 0.4);
  gfx_rect(0, ui_oy + UI_Y_HAIR*ui_sc, gfx_w, 1, 1);   // 象牙区上缘发丝线 rgba(176,141,87,.4)
);

// 标题区（U1，乌木区顶，四页全局）：衬线标题 16 + 黄铜副题（全大写·逐字距 1.2）+ 右上总开关 LED/ON·OFF；
// LED 即总开关命中区（id4=UI_A_EN，34×30，四页可点——mockup 无独立开关行，动作语义不变，偏离记录）
function ui_draw_title() (
  ui_draw_text_serif(ui_ox + 14*ui_sc, ui_oy + UI_Y_TITLE*ui_sc, UI_FS_TITLE, UI_C_TITLE, #str_title, 0);
  #ui_lsstr = #str_sub;
  ui_draw_text_ls(ui_ox + 14*ui_sc, ui_oy + UI_Y_SUB*ui_sc, UI_FS_SUB2, UI_C_BRASS, 0, 1.2, 0.55);   // .t-sub opacity .55
  ui_reg(UI_A_EN, ui_ox + 336*ui_sc, ui_oy + 22*ui_sc, 34*ui_sc, 30*ui_sc);
  cfg_enabled > 0 ? ui_set_rgb(UI_C_LEDON, 1) : ui_set_rgb(UI_C_LEDOFF, 1);
  gfx_circle(ui_ox + 362.5*ui_sc, ui_oy + (UI_Y_LED + 3.5)*ui_sc, 3.5*ui_sc, 1, 1);   // LED 实心点（fill=1+aa=1，同 geom 修复）
  cfg_enabled > 0 ? ( #ui_lsstr = #str_on; ) : ( #ui_lsstr = #str_off; );
  cfg_enabled > 0 ? ui_draw_text_ls(ui_ox + 366*ui_sc, ui_oy + UI_Y_ON*ui_sc, UI_FS_SUB2, UI_C_BRASS, 2, 1.2, 0.55)   // .t-sub .55
                  : ui_draw_text_ls(ui_ox + 366*ui_sc, ui_oy + UI_Y_ON*ui_sc, UI_FS_SUB2, UI_C_LEDOFF, 2, 1.2, 0.55);
);

// 底部状态行（U1 象牙区底部对齐，演奏页绘制）：左=音符 held_total / CC目标 合成值，右=品牌版本串；
// held 跨线程标量读 P7/N8；合成值取快照 g_diag_snap+2，初值 -1 显示 --，T3 审核挂账 N-4
function ui_draw_status() local(us_v) (
  us_v = g_mem[g_diag_snap + 2];
  us_v < 0 ? sprintf(#ui_stbuf, "%s%d / CC%d --", #str_note, st_held_total, cfg_cc)
           : sprintf(#ui_stbuf, "%s%d / CC%d %d", #str_note, st_held_total, cfg_cc, us_v);
  ui_draw_text(ui_ox + 14*ui_sc, ui_oy + UI_Y_STATUS*ui_sc, UI_FS_SUB2, UI_C_IVUNIT, #ui_stbuf, 0);
  ui_draw_text(ui_ox + (UI_W0 - 14)*ui_sc, ui_oy + UI_Y_STATUS*ui_sc, UI_FS_SUB2, UI_C_IVUNIT, #str_ver, 2);
);

// 页签栏（四页等宽；四页内容齐备：T4 演奏页 + T5 高级/诊断/说明书页；U1：y=2/h=20/gap=2 → 宽 88.5）
function ui_draw_tabs() local(ut_tw, ut_ty, ut_th, ut_wd) (
  ut_wd = (UI_W0 - UI_M*2 - UI_TAB_G*3) * 0.25;      // 设计 88.5
  ut_tw = ut_wd * ui_sc;
  ut_ty = ui_oy + UI_TAB_Y*ui_sc;
  ut_th = UI_TAB_H*ui_sc;
  ui_widget_tab(UI_A_TAB0, ui_ox + UI_M*ui_sc, ut_ty, ut_tw, ut_th, #str_t0, ui_page == 0);
  ui_widget_tab(UI_A_TAB1, ui_ox + (UI_M + ut_wd + UI_TAB_G)*ui_sc, ut_ty, ut_tw, ut_th, #str_t1, ui_page == 1);
  ui_widget_tab(UI_A_TAB2, ui_ox + (UI_M + (ut_wd + UI_TAB_G)*2)*ui_sc, ut_ty, ut_tw, ut_th, #str_t2, ui_page == 2);
  ui_widget_tab(UI_A_TAB3, ui_ox + (UI_M + (ut_wd + UI_TAB_G)*3)*ui_sc, ut_ty, ut_tw, ut_th, #str_t3, ui_page == 3);
);

// 演奏页（U1 象牙琴房）：乌木区=侧视琴架踏板（居中）+状态字（右上，总开关已移标题行 LED）；
// 象牙区=双参数卡 / 双开关+说明一行 / 三按钮；状态行钉底（全部交互 id 0–13 语义不变）
function ui_page_perf() local(pp_w, pp_bwd, pp_by) (
  // ---- 乌木区：踏板（st_auto_cc>0=踩下；跨线程标量读容忍 P7/N8）+ 状态字 ----
  ui_px = ui_ox + (UI_W0 - UI_PED_W)*0.5*ui_sc;               // lyre 左缘 设计 130
  ui_py = ui_oy + UI_Y_LYRE*ui_sc;
  ui_pw = UI_PED_W*ui_sc;
  ui_ph = UI_PED_H*ui_sc;
  ui_draw_pedal(st_auto_cc > 0 ? 1 : 0);
  ui_draw_pedstat(ui_ox + (UI_W0 - 14)*ui_sc, ui_oy + UI_Y_PEDSTAT*ui_sc, st_auto_cc > 0 ? 1 : 0);
  // ---- 象牙区：双参数卡（间距 10；卡宽 171；stepper：−=id、+=id+1）----
  pp_w = (UI_W0 - 28 - 10)*0.5*ui_sc;
  ui_note_name(cfg_bass_ceil);                                // 音名 → #ui_notebuf
  #ui_unit = #ui_notebuf;
  ui_widget_stepper(UI_A_BC_M, ui_ox + 14*ui_sc, ui_oy + UI_Y_CARD1*ui_sc, pp_w, #str_bc, cfg_bass_ceil, 0, 127, UI_BC_STEP);
  #ui_unit = "ms";
  ui_widget_stepper(UI_A_TAIL_M, ui_ox + 195*ui_sc, ui_oy + UI_Y_CARD1*ui_sc, pp_w, #str_tl, cfg_tail_ms, 0, 8000, UI_TAIL_STEP);
  // ---- 双开关（间距 10；cfg_set_param idx4/idx5）+ 说明一行 ----
  ui_widget_toggle(UI_A_CHORD, ui_ox + 14*ui_sc, ui_oy + UI_Y_TGLROW*ui_sc, pp_w, #str_ch, cfg_chord);
  ui_widget_toggle(UI_A_OCT, ui_ox + 195*ui_sc, ui_oy + UI_Y_TGLROW*ui_sc, pp_w, #str_oc, cfg_ign_oct);
  ui_draw_text(ui_ox + 14*ui_sc, ui_oy + UI_Y_HINT*ui_sc, UI_FS_SUB2, UI_C_IVUNIT, #str_hint, 0);
  // ---- 三按钮（命令槽 D1/D19；恢复默认 sliderchange(-1) 先行 D13；间距 8，按钮宽 112）----
  pp_bwd = (UI_W0 - 28 - UI_GAP*2)/3;
  pp_by = ui_oy + UI_Y_BTN*ui_sc;
  ui_widget_btn(UI_A_TAP, ui_ox + 14*ui_sc, pp_by, pp_bwd*ui_sc, UI_BTN_H*ui_sc, #str_b1);
  ui_widget_btn(UI_A_REL, ui_ox + (14 + pp_bwd + UI_GAP)*ui_sc, pp_by, pp_bwd*ui_sc, UI_BTN_H*ui_sc, #str_b2);
  ui_widget_btn(UI_A_RST, ui_ox + (14 + (pp_bwd + UI_GAP)*2)*ui_sc, pp_by, pp_bwd*ui_sc, UI_BTN_H*ui_sc, #str_b3);
  // ---- 状态行 ----
  ui_draw_status();
);

// 高级设置页（plan §4.3 高级行 / §4.2 参数表高级 7 项）：4 步进行 + 1 开关行（灰置）+ 2 步进行；
// 行卡顶 = UI_Y_ADV1 + 行号×UI_Y_ADV_DP（行号 0..6），每行下配一行 9pt 小字说明（偏移 UI_Y_ADV_D）；
// 参数全走 cfg_set_param（idx6..12）；步进量由 ui_act_fire 同源常量 UI_ADV_*_STEP 生效；
// U2 换肤（底色分区）：行卡全改象牙系（rgba(255,252,242,.65)+#cdb98d 边、墨字、值 Georgia 衬线）；
// 说明行 1/2（y=94/140）落乌木底 → chrome 暗金 TABTXT@.62（≈4.3:1）；行 3~7（y≥186）落象牙底 →
// #6d5b3e α=1（≈5.5:1，审核 I1：α .6 仅 2.6:1 弱对比）
function ui_page_adv() local(av_x, av_w, av_y, av_ds) (
  av_x = ui_ox + UI_M*ui_sc;
  av_w = (UI_W0 - UI_M*2)*ui_sc;                                 // 行卡宽（设计 360）
  // 行1 换踏间隙（idx6，0–100 步 5，单位 ms）
  av_y = ui_oy + UI_Y_ADV1*ui_sc;
  sprintf(#ui_valbuf, "%d %s", cfg_gap_ms, #str_ms);
  ui_widget_stprow(UI_A_GAP_M, av_x, av_y, av_w, #str_gap, #ui_valbuf, 1);
  ui_draw_text_a(av_x + 6*ui_sc, av_y + UI_Y_ADV_D*ui_sc, UI_FS_SUB, UI_C_TABTXT, #str_ad1, 0, 0.62);   // 乌木底
  // 行2 下踏人性化（idx7，0–50 步 1，单位 ms）
  av_y = ui_oy + (UI_Y_ADV1 + UI_Y_ADV_DP)*ui_sc;
  sprintf(#ui_valbuf, "%d %s", cfg_hum_ms, #str_ms);
  ui_widget_stprow(UI_A_HUM_M, av_x, av_y, av_w, #str_hum, #ui_valbuf, 1);
  ui_draw_text_a(av_x + 6*ui_sc, av_y + UI_Y_ADV_D*ui_sc, UI_FS_SUB, UI_C_TABTXT, #str_ad2, 0, 0.62);   // 乌木底
  // 行3 低音换踏限流窗（idx8，0–500 步 25，单位 ms）
  av_y = ui_oy + (UI_Y_ADV1 + UI_Y_ADV_DP*2)*ui_sc;
  sprintf(#ui_valbuf, "%d %s", cfg_win_bass_ms, #str_ms);
  ui_widget_stprow(UI_A_WB_M, av_x, av_y, av_w, #str_wb, #ui_valbuf, 1);
  ui_draw_text(av_x + 6*ui_sc, av_y + UI_Y_ADV_D*ui_sc, UI_FS_SUB, UI_C_IVLBL, #str_ad3, 0);            // 象牙底 α=1（I1：5.5:1）
  // 行4 重复音限流窗（idx9，0–500 步 25，单位 ms）
  av_y = ui_oy + (UI_Y_ADV1 + UI_Y_ADV_DP*3)*ui_sc;
  sprintf(#ui_valbuf, "%d %s", cfg_win_rep_ms, #str_ms);
  ui_widget_stprow(UI_A_WR_M, av_x, av_y, av_w, #str_wr, #ui_valbuf, 1);
  ui_draw_text(av_x + 6*ui_sc, av_y + UI_Y_ADV_D*ui_sc, UI_FS_SUB, UI_C_IVLBL, #str_ad4, 0);            // 象牙底 α=1（I1）
  // 行5 重复音重踏（idx10 开关；灰置：cfg_chord==0 → 禁用态 + 锁定文案，点击由 ui_act_fire 守卫不生效）
  av_y = ui_oy + (UI_Y_ADV1 + UI_Y_ADV_DP*4)*ui_sc;
  ui_widget_toggle2(UI_A_REP, av_x, av_y, av_w, #str_rep, cfg_repeat_repedal, cfg_chord != 0 ? 1 : 0);
  cfg_chord != 0 ? ( av_ds = #str_ad5; ) : ( av_ds = #str_ad5l; );
  ui_draw_text(av_x + 6*ui_sc, av_y + UI_Y_ADV_D*ui_sc, UI_FS_SUB, UI_C_IVLBL, av_ds, 0);               // 象牙底 α=1（I1）
  // 行6 通道作用域（idx11，0–16 步 1；0 显示「全部」，1–16 显示通道号；CJK 值 serif=0 走原字体槽）
  av_y = ui_oy + (UI_Y_ADV1 + UI_Y_ADV_DP*5)*ui_sc;
  cfg_ch_scope == 0 ? sprintf(#ui_valbuf, "%s", #str_all) : sprintf(#ui_valbuf, "%s%d", #str_chn, cfg_ch_scope);
  ui_widget_stprow(UI_A_SCOPE_M, av_x, av_y, av_w, #str_scope, #ui_valbuf, 0);
  ui_draw_text(av_x + 6*ui_sc, av_y + UI_Y_ADV_D*ui_sc, UI_FS_SUB, UI_C_IVLBL, #str_ad6, 0);            // 象牙底 α=1（I1）
  // 行7 CC 目标（idx12 枚举索引 0–2，显示映射 64/66/67）
  av_y = ui_oy + (UI_Y_ADV1 + UI_Y_ADV_DP*6)*ui_sc;
  sprintf(#ui_valbuf, "%s%d", #str_ccp, g_mem[g_cc_map + (slider12|0)]);
  ui_widget_stprow(UI_A_CCT_M, av_x, av_y, av_w, #str_cct, #ui_valbuf, 1);
  ui_draw_text(av_x + 6*ui_sc, av_y + UI_Y_ADV_D*ui_sc, UI_FS_SUB, UI_C_IVLBL, #str_ad7, 0);            // 象牙底 α=1（I1）
);

// 诊断页（plan §4.3 / SDS §2.5）：三真值大显示 + 按住/低音和声/发送计数 + 最近事件日志 + type6 说明行；
// 全部只读：快照 g_diag_snap、环形 g_diag、标量 diag_head（P7 跨线程标量读容忍；环形覆盖写容忍——
// 每帧重读最新 UI_DG_LOG_N 条，dp_head 本帧取一次、seq>0 判已写入槽）；日志卡内偏移 7/24/行距 16 为页内小偏移；
// U2 换肤（底色分区；审核 B2/I1/I2 修正）：三真值卡 y=66..134 全落乌木底 → 卡=rgba(255,252,242,.65)
// （混色后 ≈ 中明度暖灰 #AEA9A2），列标签 UI_C_INK@0.75（混底 4.0:1，审核 I2）、值墨字 Georgia（6.4:1）、
// 合成值改墨字 + 数值下 2px 黄铜嵌线（B2：黄铜 20pt 在混底 1.4:1 数据不可读，强调意图移装饰层）；
// 数据行 1/2（y=142/162）落乌木底裸文字 → 标签 chrome 暗金/值米白；行 3（y=182）落象牙底 →
// 标签 #6d5b3e α=1（5.5:1，审核 I1）/值墨字；日志卡/说明行（y≥206）全落象牙底 → 卡 ivory 系、
// 日志头/说明行 #6d5b3e α=1（审核 I1）、条目墨字 + 踩/抬/换踏 type 词毛毡红点缀
function ui_page_diag() local(dp_x, dp_cw, dp_y, dp_v, dp_head, dp_i, dp_k, dp_cnt, dp_mw, dp_mh, dp_nx) (
  dp_x = ui_ox + UI_M*ui_sc;
  dp_cw = (UI_W0 - UI_M*2)/3;                                    // 三真值卡三分列宽（设计 120）
  // ---- 三真值卡：硬件（快照+0）/ 自动（+1）/ 合成（+2 合成参考，-1 显示「--」，N-4/T3 挂账）----
  ui_set_rgb(UI_C_IVCARD, 0.65);
  ui_roundrect_geom(dp_x, ui_oy + UI_Y_DG_CARD*ui_sc, (UI_W0 - UI_M*2)*ui_sc, UI_DG_CARD_H*ui_sc, 7*ui_sc);
  ui_set_rgb(UI_C_IVEDGE, 1);
  gfx_roundrect(dp_x, ui_oy + UI_Y_DG_CARD*ui_sc, (UI_W0 - UI_M*2)*ui_sc, UI_DG_CARD_H*ui_sc, 7*ui_sc, 1);
  ui_draw_text_a(ui_ox + (UI_M + dp_cw*0.5)*ui_sc, ui_oy + (UI_Y_DG_CARD + 10)*ui_sc, UI_FS_SUB, UI_C_INK, #str_dg_hw, 1, 0.75);   // I2：混底 4.0:1
  ui_draw_text_a(ui_ox + (UI_M + dp_cw*1.5)*ui_sc, ui_oy + (UI_Y_DG_CARD + 10)*ui_sc, UI_FS_SUB, UI_C_INK, #str_dg_au, 1, 0.75);
  ui_draw_text_a(ui_ox + (UI_M + dp_cw*2.5)*ui_sc, ui_oy + (UI_Y_DG_CARD + 10)*ui_sc, UI_FS_SUB, UI_C_INK, #str_dg_sy, 1, 0.75);
  sprintf(#ui_lbuf, "%d", g_mem[g_diag_snap + 0]);
  ui_draw_text_serif(ui_ox + (UI_M + dp_cw*0.5)*ui_sc, ui_oy + (UI_Y_DG_CARD + 30)*ui_sc, UI_FS_NUM, UI_C_INK, #ui_lbuf, 1);
  sprintf(#ui_lbuf, "%d", g_mem[g_diag_snap + 1]);
  ui_draw_text_serif(ui_ox + (UI_M + dp_cw*1.5)*ui_sc, ui_oy + (UI_Y_DG_CARD + 30)*ui_sc, UI_FS_NUM, UI_C_INK, #ui_lbuf, 1);
  dp_v = g_mem[g_diag_snap + 2];
  dp_v < 0 ? sprintf(#ui_lbuf, "%s", #str_dg_dash) : sprintf(#ui_lbuf, "%d", dp_v);
  ui_draw_text_serif(ui_ox + (UI_M + dp_cw*2.5)*ui_sc, ui_oy + (UI_Y_DG_CARD + 30)*ui_sc, UI_FS_NUM, UI_C_INK, #ui_lbuf, 1);   // B2：混底 6.4:1
  gfx_measurestr(#ui_lbuf, dp_mw, dp_mh);                          // 量值宽（衬线槽已设）→ 黄铜嵌线居中垫于数值下
  ui_set_rgb(UI_C_BRASS, 1);
  gfx_rect(ui_ox + (UI_M + dp_cw*2.5)*ui_sc - dp_mw*0.5, ui_oy + (UI_Y_DG_CARD + 30 + 24)*ui_sc, dp_mw, 2*ui_sc, 1);   // B2 嵌线 y=120（卡底 134 上方）
  // ---- 数据行1 按住音符数（快照+3；y=142 乌木底 → 标签暗金/值米白）----
  dp_y = ui_oy + UI_Y_DG_R1*ui_sc;
  ui_draw_text_a(dp_x + 8*ui_sc, dp_y, UI_FS_SM, UI_C_TABTXT, #str_dg_held, 0, 0.62);
  sprintf(#ui_lbuf, "%d", g_mem[g_diag_snap + 3]);
  ui_draw_text(dp_x + UI_DG_VX*ui_sc, dp_y, UI_FS_SM, UI_C_TITLE, #ui_lbuf, 0);
  // ---- 数据行2 低音和声（快照+4..15 非零 pc 逐名游标绘制「C E G」式；全零显示「—」；y=162 乌木底）----
  dp_y = ui_oy + UI_Y_DG_R2*ui_sc;
  ui_draw_text_a(dp_x + 8*ui_sc, dp_y, UI_FS_SM, UI_C_TABTXT, #str_dg_bass, 0, 0.62);
  dp_cnt = 0;
  dp_i = 0;
  while (dp_i < 12) (
    g_mem[g_diag_snap + 4 + (dp_i|0)] != 0 ? ( dp_cnt = dp_cnt + 1; ) : 0;
    dp_i = dp_i + 1;
  );
  dp_cnt == 0 ? (
    ui_draw_text(dp_x + UI_DG_VX*ui_sc, dp_y, UI_FS_SM, UI_C_TITLE, #str_dg_dash, 0);
  ) : (
    dp_nx = dp_x + UI_DG_VX*ui_sc;
    dp_i = 0;
    while (dp_i < 12) (
      g_mem[g_diag_snap + 4 + (dp_i|0)] != 0 ? (
        ui_pc_name(dp_i);
        ui_draw_text(dp_nx, dp_y, UI_FS_SM, UI_C_TITLE, #ui_pcbuf, 0);
        gfx_measurestr(#ui_pcbuf, dp_mw, dp_mh);                 // ui_draw_text 已设同字号 → 量宽推进游标
        dp_nx = dp_nx + dp_mw + 6*ui_sc;
      ) : 0;
      dp_i = dp_i + 1;
    );
  );
  // ---- 数据行3 发送计数（快照+16 实发累计；y=182 象牙底 → 标签 #6d5b3e@.6/值墨字）----
  dp_y = ui_oy + UI_Y_DG_R3*ui_sc;
  ui_draw_text(dp_x + 8*ui_sc, dp_y, UI_FS_SM, UI_C_IVLBL, #str_dg_sent, 0);   // I1：象牙底 α=1（5.5:1）
  sprintf(#ui_lbuf, "%d", g_mem[g_diag_snap + 16]);
  ui_draw_text(dp_x + UI_DG_VX*ui_sc, dp_y, UI_FS_SM, UI_C_INK, #ui_lbuf, 0);
  // ---- 事件日志卡：环形最近 UI_DG_LOG_N 条（stride 4；从最新往回，seq>0 判已写、未写槽跳过）----
  // 条目三段分色（U2）：序号前缀墨 + type 词（踩/抬/换踏毛毡红点缀、其余墨）+ 余段墨；量宽推进游标
  ui_set_rgb(UI_C_IVCARD, 0.65);
  ui_roundrect_geom(dp_x, ui_oy + UI_Y_DG_LOG*ui_sc, (UI_W0 - UI_M*2)*ui_sc, UI_DG_LOG_H*ui_sc, 7*ui_sc);
  ui_set_rgb(UI_C_IVEDGE, 1);
  gfx_roundrect(dp_x, ui_oy + UI_Y_DG_LOG*ui_sc, (UI_W0 - UI_M*2)*ui_sc, UI_DG_LOG_H*ui_sc, 7*ui_sc, 1);
  ui_draw_text(dp_x + 8*ui_sc, ui_oy + (UI_Y_DG_LOG + 7)*ui_sc, UI_FS_SUB, UI_C_IVLBL, #str_dg_log, 0);   // I1：α=1（5.5:1）
  dp_head = diag_head;
  dp_i = 0;
  while (dp_i < UI_DG_LOG_N) (
    dp_k = (dp_head - 1 - dp_i + 64) % 64;                       // 从最新往回第 dp_i 条（环形回绕）
    g_mem[g_diag + (dp_k|0)*4 + 3] > 0 ? (                       // seq>0 = 已写入（未写槽 seq=0）
      ui_dg_fmt(g_mem[g_diag + (dp_k|0)*4 + 3], g_mem[g_diag + (dp_k|0)*4 + 0],
                g_mem[g_diag + (dp_k|0)*4 + 1], g_mem[g_diag + (dp_k|0)*4 + 2]);
      dp_y = ui_oy + (UI_Y_DG_LOG + 24 + dp_i*16)*ui_sc;
      dp_nx = dp_x + 8*ui_sc;
      ui_draw_text(dp_nx, dp_y, UI_FS_SM, UI_C_INK, #ui_dgp, 0);            // 段1 序号前缀（墨）
      gfx_measurestr(#ui_dgp, dp_mw, dp_mh);
      dp_nx = dp_nx + dp_mw;
      ui_draw_text(dp_nx, dp_y, UI_FS_SM, ui_dg_acc != 0 ? UI_C_FELT : UI_C_INK, #ui_dgw, 0);   // 段2 type 词
      gfx_measurestr(#ui_dgw, dp_mw, dp_mh);
      dp_nx = dp_nx + dp_mw;
      ui_draw_text(dp_nx, dp_y, UI_FS_SM, UI_C_INK, #ui_lbuf, 0);           // 段3 余段（墨；type4 空串=不绘）
    ) : 0;
    dp_i = dp_i + 1;
  );
  // ---- 说明行：type6 重同步 ≠ 实发计数（实发见发送计数）----
  ui_draw_text(dp_x, ui_oy + UI_Y_DG_NOTE*ui_sc, UI_FS_SUB, UI_C_IVLBL, #str_dg_note, 0);   // I1：α=1（5.5:1）
);

// 说明书页（plan §4.3 极简版 / IMP-5 内容清单）：安装 2 行 + 要点 7 行（①~⑤，②③各拆两行）+ 底部指向 docs；
// 纯文字逐行绘制（draw_text），无命中控件（页签除外）；行 y 全部由 UI_Y_MAN* 常量派生；
// U2 换肤（底色分区；审核 B1 复核修正——正文实为 9 行，分跨两底）：
//   乌木底 4 行正文 i1=82/i2=98/p1=146/p2=162 → 米白 UI_C_TITLE（任务字面 #33261a 在乌木底 ≈1.2:1 不可读），
//   编号 ①② 黄铜（乌木上 ≈5.6:1）；象牙底 5 行正文 p3=178/p4=194/p4b=210/p5=226/p6=242（146+16k 越 176 分界）
//   → 墨字 UI_C_INK（象牙上 ≈12.0~12.4:1），编号 ③④⑤ UI_C_IVLBL α=1（≈5.5:1；黄铜在象牙上 ≈1.5:1 不可用）；
//   节标题（y=66/130，乌木底）黄铜；「详见」行 y=432 象牙底 → UI_C_IVUNIT；安装路径行按任务许可沿用普通字体
function ui_page_manual() local(mn_x, mn_w, mn_h) (
  mn_x = ui_ox + UI_M*ui_sc;
  ui_draw_text(mn_x, ui_oy + UI_Y_MAN1*ui_sc, UI_FS_LBL, UI_C_BRASS, #str_man_h1, 0);                  // y=66 乌木底
  ui_draw_text(mn_x, ui_oy + (UI_Y_MAN1 + UI_Y_MAN_DP)*ui_sc, UI_FS_SM, UI_C_TITLE, #str_man_i1, 0);   // y=82 乌木底
  ui_draw_text(mn_x, ui_oy + (UI_Y_MAN1 + UI_Y_MAN_DP*2)*ui_sc, UI_FS_SM, UI_C_TITLE, #str_man_i2, 0); // y=98 乌木底
  ui_draw_text(mn_x, ui_oy + UI_Y_MAN2*ui_sc, UI_FS_LBL, UI_C_BRASS, #str_man_h2, 0);                  // y=130 乌木底
  // 要点行：编号先绘后量宽推进游标；p1/p2（y=146/162）乌木底=黄铜编号+米白正文，p3 起（y≥178）象牙底=棕编号+墨正文
  ui_draw_text(mn_x, ui_oy + UI_Y_MAN3*ui_sc, UI_FS_SM, UI_C_BRASS, #str_man_p1n, 0);                  // ① y=146 乌木底
  gfx_measurestr(#str_man_p1n, mn_w, mn_h);
  ui_draw_text(mn_x + mn_w, ui_oy + UI_Y_MAN3*ui_sc, UI_FS_SM, UI_C_TITLE, #str_man_p1, 0);
  ui_draw_text(mn_x, ui_oy + (UI_Y_MAN3 + UI_Y_MAN_DP)*ui_sc, UI_FS_SM, UI_C_BRASS, #str_man_p2n, 0);  // ② y=162 乌木底
  gfx_measurestr(#str_man_p2n, mn_w, mn_h);
  ui_draw_text(mn_x + mn_w, ui_oy + (UI_Y_MAN3 + UI_Y_MAN_DP)*ui_sc, UI_FS_SM, UI_C_TITLE, #str_man_p2, 0);
  ui_draw_text(mn_x, ui_oy + (UI_Y_MAN3 + UI_Y_MAN_DP*2)*ui_sc, UI_FS_SM, UI_C_INK, #str_man_p3, 0);   // y=178 象牙底（B1）
  ui_draw_text(mn_x, ui_oy + (UI_Y_MAN3 + UI_Y_MAN_DP*3)*ui_sc, UI_FS_SM, UI_C_IVLBL, #str_man_p4n, 0);// ③ y=194 象牙底（B1）
  gfx_measurestr(#str_man_p4n, mn_w, mn_h);
  ui_draw_text(mn_x + mn_w, ui_oy + (UI_Y_MAN3 + UI_Y_MAN_DP*3)*ui_sc, UI_FS_SM, UI_C_INK, #str_man_p4, 0);
  ui_draw_text(mn_x, ui_oy + (UI_Y_MAN3 + UI_Y_MAN_DP*4)*ui_sc, UI_FS_SM, UI_C_INK, #str_man_p4b, 0);  // y=210 象牙底（B1）
  ui_draw_text(mn_x, ui_oy + (UI_Y_MAN3 + UI_Y_MAN_DP*5)*ui_sc, UI_FS_SM, UI_C_IVLBL, #str_man_p5n, 0);// ④ y=226 象牙底（B1）
  gfx_measurestr(#str_man_p5n, mn_w, mn_h);
  ui_draw_text(mn_x + mn_w, ui_oy + (UI_Y_MAN3 + UI_Y_MAN_DP*5)*ui_sc, UI_FS_SM, UI_C_INK, #str_man_p5, 0);
  ui_draw_text(mn_x, ui_oy + (UI_Y_MAN3 + UI_Y_MAN_DP*6)*ui_sc, UI_FS_SM, UI_C_IVLBL, #str_man_p6n, 0);// ⑤ y=242 象牙底（B1）
  gfx_measurestr(#str_man_p6n, mn_w, mn_h);
  ui_draw_text(mn_x + mn_w, ui_oy + (UI_Y_MAN3 + UI_Y_MAN_DP*6)*ui_sc, UI_FS_SM, UI_C_INK, #str_man_p6, 0);
  ui_draw_text(mn_x, ui_oy + UI_Y_MAN_REF*ui_sc, UI_FS_SM, UI_C_IVUNIT, #str_man_ref, 0);              // y=432 象牙底
);

// 每帧起点：等比缩放（比例+下限钳制）与内容框居中偏移 + 命中区重建起点
function ui_frame_begin() (
  ui_sc = min(gfx_w / UI_W0, gfx_h / UI_H0);
  ui_sc < UI_SC_MIN ? ( ui_sc = UI_SC_MIN; ) : 0;
  ui_ox = (gfx_w - UI_W0*ui_sc)*0.5;
  ui_oy = (gfx_h - UI_H0*ui_sc)*0.5;
  ui_hit_clear();
);

// 鼠标状态机：上升沿按下（命中捕获；连发型按下即触发第一次）→ 按住跟踪（>350ms 起每 ~100ms 连发）→
// 抬起 fire（非连发型；连发型抬起不重复触发）。按下捕获语义：按住期间以按下时槽为准（拖出不取消），plan 未规定，记设计自定。
// 计时用 time_precise（I3 修复：内置 time 为 1 秒粒度，350ms/100ms 阈值需亚毫秒时钟，REAPER 4.60+）
function ui_handle_mouse() local(hm_cap, hm_id, hm_tp) (
  hm_cap = mouse_cap & 1;
  hm_tp = time_precise;                                      // 本帧时刻（亚毫秒，每帧取一次）
  hm_cap != 0 && ui_cap_prev == 0 ? (                        // 上升沿=按下
    hm_id = ui_hit_at(mouse_x, mouse_y);
    ui_dn_slot = hm_id;
    ui_dn_t = hm_tp;
    ui_rep_t = hm_tp;
    ui_is_repeat(hm_id) != 0 ? ( ui_act_fire(hm_id); ) : 0;  // 连发型：第一次立即
  ) : 0;
  hm_cap != 0 && ui_cap_prev != 0 && ui_dn_slot >= 0 && ui_is_repeat(ui_dn_slot) != 0 ? (   // 按住跟踪
    hm_tp - ui_dn_t > 0.35 && hm_tp - ui_rep_t >= 0.1 ? (
      ui_act_fire(ui_dn_slot);
      ui_rep_t = hm_tp;
    ) : 0;
  ) : 0;
  hm_cap == 0 && ui_cap_prev != 0 ? (                        // 下降沿=抬起
    ui_dn_slot >= 0 && ui_is_repeat(ui_dn_slot) == 0 ? ( ui_act_fire(ui_dn_slot); ) : 0;
    ui_dn_slot = -1;
  ) : 0;
  ui_cap_prev = hm_cap;
);

// 帧主函数（@gfx 唯一入口）：首帧门控初始化 → 缩放/清 hit → 背景/标题/页签 → 页内容 → 鼠标状态机
function ui_draw() (
  ui_inited == 0 ? (
    ui_page = 0;          // 首帧初始化：页=0（演奏页）
    ui_dn_slot = -1;
    g_mem[g_diag_snap + 2] = -1;   // N7：未播放时快照合成参考置 -1 → 状态行显示「--」而非 0
    ui_hit_clear();       // 清 hit 区
    ui_inited = 1;
  ) : 0;
  ui_frame_begin();
  ui_draw_bg();        // U1 全局背景：乌木+黄铜/毛毡分隔+象牙（四页共享）
  ui_draw_title();
  ui_draw_tabs();
  ui_page == 0 ? ui_page_perf() : ui_page == 1 ? ui_page_adv() : ui_page == 2 ? ui_page_diag() : ui_page_manual();
  ui_handle_mouse();
);

st_resync_pending = 1;   // D7: 每次播放启动强制首块重同步（plan §4.1/§7.16）

cfg_sync_from_sliders();   // D23：@init 末尾无条件同步（只读 slider；采样率变化由 @slider 双保险）

@serialize
// D7 v1.3：非空占位——仅此一条赋值，不持久化任何变量（用户参数由 slider 自动保存承担）；
// 非空 @serialize 阻止变量清零；跨播放启动存续；工程重载=全零+首块哨兵（见 @block 步0）
st_serialize_marker = 1;

@slider
// 宿主侧参数变化 → 重同步派生状态（D23 双保险；@init 后必随再跑）
cfg_sync_from_sliders();

@block
io_process_block();   // §2.4 全序列：哨兵引导 / 时基 / 沿检测+重同步 / 关态门控 / 命令槽 / midirecv / ped_tick / 收尾+diag 快照

@gfx
ui_draw();   // 四页 UI：T4 框架+演奏页，T5 高级设置/诊断/说明书页
